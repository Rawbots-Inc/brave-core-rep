<translation id="1547469039832541117">დაასრულებს მონიშნულ ამოცანას.</translation>
<translation id="1530633922026945685">Freedom საჭიროებს თქვენს კამერაზე წვდომის ნებართვას, თქვენი გარემოს 3-განზომილებიანი რუკის შექმნა რომ შეძლოს</translation>
<translation id="9125033103884432">{NUM_EXTENSIONS,plural, =1{ეს გაფართოება აღარ არის მხარდაჭერილი. Freedom გირჩევთ მის ამოშლას.}other{ეს გაფართოებები აღარ არის მხარდაჭერილი. Freedom გირჩევთ, ამოშალოთ ისინი.}}</translation>
<translation id="51545890371361355">Freedom-ის ჩამაგრება</translation>
<translation id="6570689355868013775">Freedom-ის უსაფრთხოების ხელსაწყოები</translation>
<translation id="1902837727299679178">Freedom-ს სურს თქვენი პაროლების მმართველის მონაცემების წაშლა. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="4449148723378534338">გადახედეთ კონფიდენციალურობისა და უსაფრთხოების მართვის საკვანძო საშუალებებს Freedom-ში</translation>
<translation id="1640672724030957280">მიმდინარეობს ჩამოტვირთვა…</translation>
<translation id="1680687534629375545">სურათების ძიებისთვის ამ გვერდის შესახებ შეკითხვა</translation>
<translation id="1709772298389099340">უზრუნველყოფს მაღალ პრივილეგიებს <ph name="BROWSER_NAME"/>-ისთვის.</translation>
<translation id="2913217021115517297">ამ ფუნქციების გაუმჯობესების მიზნით, თქვენს მათთან ურთიერთქმედებას Freedom გაუგზავნის Freedom-ს. აღნიშნული მონაცემების წაკითხვა, დამუშავება და ანოტირება, შესაძლოა, განხორციელდეს ადამიანი მიმომხილველების მიერ.</translation>
<translation id="1722488837206509557">ამის საშუალებით თქვენ აირჩევთ ხელმისაწვდომი მოწყობილობებიდან და მათზე კონტენტს აჩვენებთ.</translation>
<translation id="8004287232784878841">Freedom მალე წაშლის დათვალიერების მონაცემებს</translation>
<translation id="4197839351786449392">Freedom შეეცდება, გადაიტანოს ნავიგაცია HTTPS-ზე</translation>
<translation id="7814200940910057384">Freedom-ის მონაცემები გასუფთავდა</translation>
<translation id="9048361966237194186">Freedom გაეშვება <ph name="REMAINING_TIME"/>-ში</translation>
<translation id="5524150602137990006">როცა HTTPS მიუწვდომელია, Freedom გამოიყენებს დაუცველ კავშირს თქვენი გაფრთხილების გარეშე</translation>
<translation id="6797402139308059782">დავრთოთ ნება Freedom-ს გაშვებული იყოს ფონურ რეჟიმში</translation>
<translation id="5875673934455379806">Freedom-ის ხელახალი ინსტალაცია</translation>
<translation id="4529028207655448215">Freedom ცდილობს შემდეგს: <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="1838374766361614909">ძიების გასუფთავება</translation>
<translation id="3541642064306182066">დათვალიერების მონაცემების მხოლოდ ამ მოწყობილობიდან წასაშლელად და Freedom ანგარიშში მათ შესანარჩუნებლად <ph name="BEGIN_LINK"/>გამოდით Freedom-იდან<ph name="END_LINK"/>.</translation>
<translation id="4559627161887338743">შეგიძლიათ მართოთ თქვენი სისტემაში შესული Freedom ანგარიშები. თქვენი Freedom ანგარიშები გამოიყენება Freedom ბრაუზერისთვის, Play Store-ისთვის, Gmail-ისთვის და სხვა პროდუქტებისთვის. თუ სხვისი, მაგალითად, ოჯახის წევრის, ანგარიშის დამატება გსურთ, სანაცვლოდ დაამატეთ ახალი პიროვნება თქვენს <ph name="DEVICE_TYPE"/>-ს. <ph name="LINK_BEGIN"/>შეიტყვეთ მეტი<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">სურათების ძიებით მოძიება</translation>
<translation id="1880677175115548835">ტექსტის არჩევა</translation>
<translation id="4528406859989804913">თქვენ შედიხართ სისტემაში მართული ანგარიშით და ამით აძლევთ ადმინისტრატორს კონტროლს თქვენს Freedom-ის პროფილზე. თქვენი Freedom-ის მონაცემები, როგორიცაა პროგრამები, სანიშნეები, ისტორია, პაროლები და სხვა პარამეტრები სამუდამოდ მიემაგრება <ph name="USER_NAME"/>-ს. თქვენ შეძლებთ ამ მონაცემების წაშლას Freedom ანგარიშების საინფორმაციო დაფის მეშვეობით, თუმცა ამ მონაცემების დაკავშირებას სხვა ანგარიშთან ვერ შეძლებთ. სურვილისამებრ, შეგიძლიათ შექმნათ ახალი პროფილი, არსებული Freedom-ის მონაცემების ცალკე შესანახად. <ph name="LEARN_MORE"/></translation>
<translation id="2207454583030080759">Freedom დაზოგავს ბატარეის მუხტს ვიზუალური ეფექტებისა (მაგალითად, ლივლივა გადაადგილებისა და ვიდეოკადრების სიხშირის) და ფონური აქტივობის შეზღუდვის გზით. <ph name="BEGIN_LINK"/>შეიტყვეთ მეტი ენერგიის დამზოგის შესახებ<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">იკითხეთ ამ გვერდის შესახებ</translation>
<translation id="8643267611122541711">Freedom-ის განმაახლებელი სერვისი</translation>
<translation id="712480009194450642">როცა შესული ხართ, Freedom-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Freedom ანგარიშიდან. ამის შეცვლა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="1649714546770135458">ამ პარამეტრის გამორთვის შემთხვევაში, Freedom-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ Freedom-ში შესვლის გარეშე</translation>
<translation id="916979339327923175">ამ აპების მონაცემების Freedom-იდან ამოშლა</translation>
<translation id="189297655255130768">Freedom არ პასუხობს. გავუშვათ ხელახლა?</translation>
<translation id="8422047647688939115">თქვენი ორგანიზაცია, <ph name="MANAGER"/>, მოითხოვს, რომ Freedom-ში შეხვიდეთ</translation>
<translation id="4035053306113201399">განახლების მისასადაგებლად ChromeOS უნდა გადაიტვირთოს.</translation>
<translation id="9048754176089806686">Freedom-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ტიპის ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="1953553007165777902">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="MINUTE"/> წუთი</translation>
<translation id="1775322105159056176">Freedom ნაგულისხმევ ბრაუზერს ვერ საზღვრავს, ან ვერ აყენებს</translation>
<translation id="4372901050442507812">შეიტყვეთ, რატომ ბლოკავს Freedom ზოგიერთ ფაილს, გაიხსნება ახალ ჩანართში</translation>
<translation id="2703425183860615504">იზრუნებს, რომ თქვენი Freedom-ის პროგრამული უზრუნველყოფა განახლებული იყოს. თუ ეს სერვისი გაითიშება ან შეჩერდება, Freedom-ის პროგრამული უზრუნველყოფა აღარ განახლდება, რაც იმას ნიშნავს, რომ უსაფრთხოებასთან დაკავშირებული პოტენციური საფრთხეების აღმოფხვრა აღარ მოხდება და ფუნქციებმა შეიძლება არ იმუშაოს. ეს სერვისი დეინსტალირდება, როცა მისით მოსარგებლე Freedom-ის პროგრამული უზრუნველყოფა არ არსებობს.</translation>
<translation id="9220324636239049437">ეს მოქმედება წაშლის 1 ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Freedom-ში, როგორც <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">ინსტალაცია ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="831418749472885028"><ph name="BEGIN_LINK"/>შედით Freedom-ში<ph name="END_LINK"/>, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს სხვა პაროლებს.</translation>
<translation id="2039417478970545937">პარამეტრები.</translation>
<translation id="5499149312981370855">აირჩიეთ, დაერთოს თუ არა Freedom ისტორია, Freedom სერვისებში უფრო პერსონალიზებული ფუნქციებით რომ ისარგებლოთ</translation>
<translation id="5888420425384578947">მომავალში Freedom-ის განახლებების მისაღებად დაგჭირდებათ macOS 12 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს macOS 11-ს.</translation>
<translation id="2472891440303445472">Freedom-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს ფაილი შეცდომაში შემყვანია და მას შეუძლია მოულოდნელი ცვლილებების განხორციელება თქვენს მოწყობილობაზე</translation>
<translation id="2726948994393234543">თქვენი პაროლები და Freedom-ის სხვა მონაცემები, რომლებიც შენახულია თქვენს Freedom ანგარიშში, ამოიშლება ამ მოწყობილობიდან. Freedom-ში რომ ისინი ხელახლა გამოიყენოთ, საჭიროა ანგარიშში შესვლა.</translation>
<translation id="4375530476448642348">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა Freedom არ გამოიყენება 1 წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}other{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა Freedom არ გამოიყენება # წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}}</translation>
<translation id="2126108037660393668">ჩამოტვირთული ფაილის დადასტურება ვერ მოხერხდა.</translation>
