<translation id="175926951572479413"><ph name="MANAGER"/> მართავს Freedom-ს</translation>
<translation id="3579012341787637143">Freedom პროფილის დამატება</translation>
<translation id="6786534271003695094">Freedom for Testing-ის შესახებ</translation>
<translation id="526235294307144732">თქვენს Freedom ანგარიშში Freedom-ის მონაცემები რომ გამოიყენოთ და შეინახოთ, შეიყვანეთ თქვენი საიდუმლო ფრაზა</translation>
<translation id="4493028449971051158">გაშვების შეცდომა: ინსტალატორი გაუშვით, როგორც ადმინისტრატორმა.</translation>
<translation id="4501471624619070934">ინსტალაცია ვერ მოხერხდა, რადგან წვდომა შეზღუდულია ამ ქვეყანაში</translation>
<translation id="8594994021633965927">ამ გაფართოებას არ გამოუქვეყნებია კონფიდენციალური ინფორმაციის გამოყენების პრაქტიკა, მაგალითად, მონაცემების შეგროვებისა და გამოყენების წესები. Freedom გირჩევთ მის ამოშლას.</translation>
<translation id="7084397798469173252">მოგესალმებით Freedom-ში; გახსნილია ბრაუზერის ახალი ფანჯარა</translation>
<translation id="137732229629632648">თქვენი გარემოს მოსანიშნად და თქვენი ხელებისთვის თვალის მიდევნებისთვის Freedom საჭრიროებს ნებართვას</translation>
<translation id="5917968343741192617">Freedom ფორმებს უკეთ აღიქვამს და უფრო სწრაფად შეუძლია მათი შევსება</translation>
<translation id="5036046007335188949">თქვენ უკვე შესული ხართ Freedom-ის სხვა პროფილში როგორც <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="1878185978731985193">Freedom წინასწარ ჩატვირთავს გვერდებს, რაც დააჩქარებს დათვალიერებას და ძიებას. <ph name="BEGIN_LINK"/>შეიტყვეთ მეტი წინასწარ ჩატვირთული გვერდების შესახებ<ph name="END_LINK"/></translation>
<translation id="4567424176335768812">თქვენ შესული ხართ, როგორც <ph name="USER_EMAIL_ADDRESS"/>. ახლა შეგიძლიათ გახსნათ თქვენი სანიშნეები, ისტორია და სხვა პარამეტრები ყველა მოწყობილობიდან, რომელშიც შესული ხართ.</translation>
<translation id="8669339108356170796">Freedom-მა დაბლოკა ეს ჩამოტვირთვა, რადგან Safe Browsing გამორთეთ და ფაილის შემოწმება ვერ ხერხდება</translation>
<translation id="4594305310729380060">პაროლების მმართველში ამ მოწყობილობაზე</translation>
<translation id="300669147395456190">Freedom პროგრამები</translation>
<translation id="4598116752460667024">სიიდან ნებისმიერი პროცესის მოძიება.</translation>
<translation id="4970880042055371251">ChromeOS-ის ვერსია</translation>
<translation id="2182657378556811785">განახლება თითქმის მზად არის! დასასრულებლად, ხელახლა გაუშვით Freedom.</translation>
<translation id="6311668361877328515">აჩქარებს Freedom-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ Freedom ოდნავ ნაკლებად უძლებს შეტევებს</translation>
<translation id="7843665350820058984">Freedom ფორმებს უკეთ აღიქვამს და უფრო სწრაფად შეუძლია მათი შევსება. ეს პარამეტრი ჩართულია.</translation>
<translation id="7402642357351265733">თუ Freedom-ის მოხმარების ანგარიშებსაც გააზიარებთ, მათ თქვენ მიერ მონახულებულ URL-ებიც დაერთვება</translation>
<translation id="8142245354207161805">როგორც ჩანს, პროფილი გამოიყენება სხვა Freedom პროცესის მიერ (<ph name="PROCESS_ID"/>) სხვა კომპიუტერში (<ph name="HOST_NAME"/>). Freedom-მა დაბლოკა პროფილი, რათა არ დაზიანდეს. თუ დარწმუნებული ხართ, რომ სხვა პროცესები არ იყენებენ ამ პროფილს, შეგიძლიათ განბლოკოთ პროფილი და ხელახლა გაუშვათ Freedom.</translation>
<translation id="4680828127924988555">ინსტალაციის გაუქმება</translation>
<translation id="2014343159590733363">თქვენი Freedom-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Freedom ანგარიშში. სისტემიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში, აღნიშნული მონაცემები წაიშლება.</translation>
<translation id="2408746614080689238">როცა შესული ხართ, Freedom-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Freedom ანგარიშიდან. <ph name="SHORTCUT"/> შეცვლის თქვენი Freedom სერვისების პარამეტრებს.</translation>
