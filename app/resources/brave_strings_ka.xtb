<translation id="7130675370997202556">Freedom ის გახსნისა და დათვალიერების დაწყებისათვის დააჭირეთ თქვენი სახელს.</translation>
<translation id="3892148308691398805">ტექსტის კოპირება</translation>
<translation id="4920958997042285125"><ph name="EXISTING_USER"/> უკვე შესულია ამ Freedom პროფილში. თქვენი დათვალიერების მონაცემები რომ განაცალკევოთ, Freedom-ს შეუძლია თქვენთვის პერსონალური პროფილის შექმნა.</translation>
<translation id="8744239658215739511">თქვენი Freedom-ის მორგება</translation>
<translation id="3941890832296813527">შეცდომა ინსტალაციისას: ინსტალატორის ფაილის სახელი არასწორი ან მხარდაუჭერელია.</translation>
<translation id="8090497651549769448">Freedom ცდილობს პაროლების კოპირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="4256965182800026277">ამ მოწყობილობიდან ამოიშლება თქვენი პაროლები, გადახდის მეთოდები და მისამართები, რომლებიც შეინახეთ თქვენს Freedom ანგარიშში. Freedom-ში რომ ისინი ხელახლა გამოიყენოთ, საჭიროა ანგარიშში შესვლა.</translation>
<translation id="395904275706073188">დაცული გვერდების წაკითხვა შეუძლებელია. ცადეთ სხვა გვერდი.</translation>
<translation id="4194619960643453552">შეიტყვეთ, როგორ ზრუნავს Freedom თქვენს უსაფრთხოებაზე</translation>
<translation id="1486377520191913768">როდესაც მისამართთა ზოლში ან საძიებო ველში ტექსტი შეგყავთ, Freedom აგზავნის მას თქვენი ორგანიზაციის საძიებო სისტემაში, ხელოვნურ ინტელექტთან და აგენტის ხელსაწყოებში, რათა მიიღოს შემოთავაზებები.</translation>
<translation id="1311808042904310985">Freedom for Testing-ის შ&amp;ესახებ</translation>
<translation id="1152920704813762236">ChromeOS-ის შესახებ</translation>
<translation id="3703994572283698466">ChromeOS და <ph name="BEGIN_LINK_LINUX_OSS"/>Linux-ის შემუშავების გარემო <ph name="END_LINK_LINUX_OSS"/> მუშაობს <ph name="BEGIN_LINK_CROS_OSS"/>ღია კოდის დამატებითი პროგრამული უზრუნველყოფის<ph name="END_LINK_CROS_OSS"/> დამსახურებით.</translation>
<translation id="4022972681110646219">ეკრანის თარგმნა</translation>
<translation id="4023601594785368013">ორიგინალის ენა: <ph name="LANGUAGE"/></translation>
<translation id="5540160525564738506">გახსნის ბმულებს Freedom-ში ნებისმიერი აპიდან. დამატებით, მარტივი წვდომისთვის ის ჩამაგრდება თქვენს ამოცანათა ზოლში.</translation>
<translation id="6056473803837713617">ხელი შეუწყვეთ Freedom-ის გაუმჯობესებას <ph name="BEGIN_LINK"/>მიმდინარე პარამეტრების<ph name="END_LINK"/> გამოგზავნის მეშვეობით</translation>
<translation id="4050175100176540509">უსაფრთხოების მნიშვნელოვანი გაუმჯობესება და ახალი თვისებები ხელმისაწვდომია უახლეს ვერსიაში.</translation>
<translation id="4055805654398742145">პ&amp;აროლების მმართველი</translation>
<translation id="6654312501894761082">სხვა პროგრამამ თქვენს კომპიუტერში დაამატა გაფართოება, რომელმაც შეიძლება შეცვალოს Freedom-ის მუშაობის პრინციპი.

<ph name="EXTENSION_NAME"/></translation>
<translation id="6217792792122501564">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად ხურავს Freedom-ს, როცა ის 1 წუთის განმავლობაში არ გამოიყენება. დათვალიერების მონაცემები წაიშლება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.}other{თქვენი ორგანიზაცია ავტომატურად ხურავს Freedom-ს, როცა ის # წუთის განმავლობაში არ გამოიყენება. დათვალიერების მონაცემები წაიშლება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.}}</translation>
<translation id="5794951150713244901">Freedom-ის შესახებ ინფორმაციის გვერდზე გადასვლა</translation>
<translation id="6596295505984504022">თქვენი Freedom-ის მორგება</translation>
<translation id="4148957013307229264">ინსტალაცია…</translation>
<translation id="4658486203392098459"><ph name="PAGE_TITLE"/> — ქსელში შესვლა — Freedom</translation>
<translation id="2871190378186459992">აღმოაჩინეთ შესანიშნავი აპები, თამაშები, გაფართოებები და თემები Freedom-ისთვის.</translation>
<translation id="462105622535258178">ამ გაფართოების და სხვა ერთეულების თქვენს კომპიუტერზე მისაღებად შედით Freedom-ში</translation>
<translation id="6670140629169983459">ონლაინ უსაფრთხოების დასაცავად, თქვენი მშობლის არჩევანით, გადართეთ Freedom პროფილზე, რომელშიც უკვე შესული ხართ, როგორც <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="4222932583846282852">მიმდინარეობს გაუქმება…</translation>
<translation id="4224210481850767180">ინსტალაცია გაუქმდა.</translation>
<translation id="1853997773668795891">დავუკავშიროთ თქვენი Freedom მონაცემები ამ ანგარიშის?</translation>
<translation id="4732930052828648898">გაგაფრთხილებთ სახიფათო საიტების შესახებ (თუნდაც Freedom-ისთვის იქამდე უცნობის შესახებ) საიტებიდან იმაზე მეტი მონაცემის სკანირების მეშვეობით, ვიდრე სტანდარტული დაცვის შემთხვევაში. სურვილისამებრ, შეგიძლიათ გამოტოვოთ Freedom-ის გაფრთხილებები.</translation>
<translation id="2201661640076600072">Freedom-იდან გასვლა</translation>
<translation id="3262506503470845422">Freedom-თან დაკავშირებული დახმარების მიღება</translation>
<translation id="4281844954008187215">მომსახურების პირობები</translation>
<translation id="7691786510374174420">ინსტალაცია ვერ განხორციელდა განუსაზღვრელი შეცდომის გამო. თუ Freedom ამჟამად გაშვებულია, დახურეთ იგი და ხელახლა სცადეთ.</translation>
<translation id="6368144843345980623">Freedom-იდან პაროლების ექსპორტი</translation>
<translation id="4304713468139749426">პაროლების მმართველი</translation>
<translation id="4334241893986177674">ეკრანის ამ ანაბეჭდის მოძიება</translation>
<translation id="4334294535648607276">ჩამოტვირთვა დასრულდა.</translation>
<translation id="1068681683510904753"><ph name="MANAGER"/> მოითხოვს, რომ ამ მოწყობილობის გამოყენებამდე წაიკითხოთ ქვემოთ მოცემული მომსახურების პირობები და დაეთანხმოთ მათ. აღნიშნული პირობები არ არის ChromeOS-ის წესების დამატება, ასევე, არ ცვლის და არც ზღუდავს მათ.</translation>
<translation id="9183662282810237335">მაინც გსურთ Freedom-იდან გასვლა?</translation>
<translation id="4413205837991854510">სურათების ძიების მალსახმობის ყოველთვის ჩვენება</translation>
<translation id="4065288863231444640">Freedom-ისთვის ფონურ რეჟიმში მუშაობის დაშვება</translation>
<translation id="1749140836512789834">{NUM_EXTENSIONS,plural, =1{Freedom გირჩევთ მის ამოშლას. <ph name="BEGIN_LINK"/>შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK"/>}other{Freedom გირჩევთ მათ ამოშლას. <ph name="BEGIN_LINK"/>შეიტყვეთ მეტი მხარდაჭერილი გაფართოებების შესახებ<ph name="END_LINK"/>}}</translation>
<translation id="8148611988012584308">Freedom-ის მორგება და კონტროლი</translation>
<translation id="4427306783828095590">გაძლიერებული დაცვა გთავაზობთ ფიშინგისა და მავნე პროგრამებისგან დაცვის მეტ საშუალებას</translation>
