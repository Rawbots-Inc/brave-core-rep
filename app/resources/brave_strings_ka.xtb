<translation id="8616874628011103667">ყველა საერთო მოხმარების კომპიუტერზე ადვილი გახდა Freedom ანგარიშით Freedom-ის გამოყენება.</translation>
<translation id="4264606872840545968">Freedom-ის მალსახმობი</translation>
<translation id="6890616081898535725">Freedom-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="335632367599648646">ნამდვილად გსურთ მოახდინოთ Freedom-ის დეინსტალაცია?</translation>
<translation id="6375219077595103062">დაამატეთ პაროლების მმართველის მალსახმობი</translation>
<translation id="6388799252195623474">დახმარება მჭირდება</translation>
<translation id="7920857181125123335">გასაგრძელებლად შედით Freedom-ში ანგარიშით <ph name="EMAIL"/>. ამგვარად თქვენს ხელთ იქნება თქვენი ორგანიზაციის დებულებები.</translation>
<translation id="3256100650978957522">Freedom-ის ლოგო კომპიუტერის ეკრანზე.</translation>
<translation id="6373767849825830651">Freedom არის ვებ ბრაუზერი, რომელიც ვებგვერდებს და აპლიკაციებს ელვისებური სისწრაფით ხსნის. ის არის სწრაფი, სტაბილური და გამოსაყენებლად მარტივი. დაათვალიერეთ ვები უფრო უსაფრთხოდ Freedom-ში ჩაშენებული საზიანო პროგრამული უზრუნველყოფისა და თაღლითობისგან დაცვის საშუალებით.</translation>
<translation id="6436260184216827876">სურათების ძიება მიუწვდომელია. ცადეთ მოგვიანებით.</translation>
<translation id="2139300032719313227">გადატვირთეთ ChromeOS</translation>
<translation id="638302211119176182">Freedom წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="890319829408077946">გამორთული • Freedom ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="1684121725014454063">მოგესალმებათ Freedom პროფილები</translation>
<translation id="7906693299331092358">ანგარიშის ამოშლა Freedom-იდან</translation>
<translation id="2675662665675552980">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Freedom-ის გაშვებისას.</translation>
<translation id="648319183876919572">გაძლიერებული Safe Browsing მეტად გიცავთ სახიფათო ვებსაიტებისა და ჩამოტვირთვებისგან</translation>
<translation id="5590013613412457132">Freedom-ის დეინსტალაცია</translation>
<translation id="7185585387858242335">მალსახმობები იხსნება Freedom-ში</translation>
<translation id="3617744907966785605">თქვენი ორგანიზაცია ხურავს Freedom-ს, როცა ის <ph name="TIMEOUT_DURATION"/> არ გამოიყენება. დათვალიერების მონაცემები წაიშალა. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="8646609321956191980">თითოეულ პროფილში ინახება საკუთარი Freedom ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="6756656512757374876">შეიტყვეთ მეტი იმის შესახებ, თუ <ph name="BEGIN_LINK"/>როგორ ინარჩუნებს Freedom თქვენი მონაცემების კონფიდენციალურობას<ph name="END_LINK"/></translation>
<translation id="3556601443414636547">ამ პარამეტრის ცვლილება ამოქმედდება Freedom-ის გადატვირთვისთანავე.</translation>
<translation id="2535436634051789953">ახლა შეგიძლიათ გადართვა, პაროლები სხვა Freedom პროფილიდან რომ ნახოთ</translation>
<translation id="2312399718665761438">მართლწერის შეცდომების გასასწორებლად, Freedom თქვენ მიერ ტექსტის ველში აკრეფილ ტექსტებს Freedom-ს უგზავნის</translation>
<translation id="3507835409099344374">Freedom-ის შეტყობინების პარამეტრებზე გადასვლა</translation>
<translation id="6600016381025017075">მოძებნეთ ნებისმიერი რამ ამ გვერდზე</translation>
<translation id="9156965752763025780">თქვენი ცვლილებები გააქტიურდება Freedom-ის შემდეგი გაშვებისას.</translation>
<translation id="3119017564683030312">გააგრძელეთ იქიდან, სადაც გაჩერდით: Freedom-მა აღადგინა ჩანართები თქვენი ბოლო სესიიდან. ამის გამორთვა შეგიძლიათ აქ:</translation>
<translation id="245693535809364497">თქვენი შემოგარენის 3-განზომილებიანი რუკის შესაქმნელად Freedom საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="9210457680074341078">თუ თქვენს სანიშნეებს Freedom ანგარიშშიც ინახავთ, შეგიძლიათ თვალი მიადევნოთ პროდუქტების ფასებს Freedom-ში და შეიტყოთ, როცა ფასი დაიკლებს</translation>
<translation id="6676384891291319759">წვდომა ინტერნეტზე</translation>
<translation id="1363996462118479832">ChromeOS-მა ვერ დაასინქრონა თქვენი მონაცემები შესვლის შეცდომის გამო.</translation>
<translation id="5324448127277983819">Freedom გაძლევთ მეტ კონტროლს თქვენთვის ხილულ რეკლამაზე. ის, ასევე, ზღუდავს იმას, თუ რომელ საიტებს შეუძლია თქვენ შესახებ ინფორმაციის მიღება, როცა მათ მიერ თქვენთვის ნაჩვენებია პერსონალიზებული რეკლამა.</translation>
<translation id="1257247502847251159">Freedom საჭიროებს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="6712881677154121168">შეცდომა ჩამოტვირთვისას: <ph name="DOWNLOAD_ERROR"/></translation>
<translation id="1489465648257900784">თქვენი პროფილის გამოყენება შეუძლებელია, რადგან ის Freedom-ის უახლესი ვერსიიდანაა.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს. გთხოვთ მიუთითოთ სხვადასხვა პროფილის დირექტორია ან გამოიყენეთ Freedom-ის ახალი ვერსია.</translation>
<translation id="1505112054322049777">პერსონალიზაციის და სხვა ფუნქციებით რომ ისარგებლოთ, დაურთეთ Freedom როგორც ვებსა და აპებში აქტივობას, ისე მიბმულ Freedom სერვისებს</translation>
