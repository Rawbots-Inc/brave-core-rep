<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lv">
<translation id="1026101648481255140">Atsākt instalēšanu</translation>
<translation id="7099479769133613710">Atkārtoti palaist, lai atjauninātu &amp;Freedom OS</translation>
<translation id="7061050486072297552">Freedom labāk izprot veidlapas un var ātrāk tās automātiski aizpildīt. Šis iestatījums ir izslēgts.</translation>
<translation id="2479110114759182442">Freedom komanda iesaka pārskatīt šo paplašinājumu.</translation>
<translation id="3814674848168165531">Kad vietnē tiek piedāvāts privāti iepriekš ielādēt saites lapā, pārlūks Freedom izmanto Freedom serverus. Tādējādi jūsu identitāte tiek slēpta no iepriekš ielādētās lapas īpašniekiem, taču Freedom uzzina, kādas lapas tiek iepriekš ielādētas.</translation>
<translation id="1065672644894730302">Jūsu preferences nevar nolasīt. Dažas funkcijas var nebūt pieejamas, un preferenču izmaiņas netiks saglabātas</translation>
<translation id="7577672138294294152">Viens no jūsu vecākiem ir izslēdzis iestatījumu “Atļaujas vietnēm, lietotnēm un paplašinājumiem” pārlūkam Freedom.</translation>
<translation id="5918095577778020936">Pārlūkā Freedom tiek mēģināts eksportēt jūsu paroles. Lai to atļautu, ievadiet savu Windows paroli.</translation>
<translation id="112640046208448578">Varat identificēt priekšmetus vai vietas un kopēt vai tulkot tekstu. Kad izmantojat funkciju Attēlu meklēšana, uz serveri tiek nosūtīts lapas ekrānuzņēmums. <ph name="LEARN_MORE"/></translation>
<translation id="5468853758063275923">Jūsu noklusējuma pārlūks ir Freedom.</translation>
<translation id="8522292744959221145">Lai pārbaudītu, vai jūsu paroles ir aizsargātas pret datu pārkāpumiem un citām drošības problēmām, <ph name="BEGIN_LINK"/>pierakstieties pārlūkā Freedom<ph name="END_LINK"/>.</translation>
<translation id="2627788872035182013">Noklikšķiniet uz Freedom izvēlnes</translation>
<translation id="1157985233335035034">Nesen izmantotās valodas</translation>
<translation id="7813580490378477695"><ph name="PARTNER_NAME"/> pievienoja paplašinājumu, kas var ietekmēt pārlūka Freedom darbību.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">Instalēšana neizdevās, jo jūsu izmantotā Windows versija netiek atbalstīta.</translation>
<translation id="8541922081612557424">Par Freedom</translation>
<translation id="1203500561924088507">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME"/> izmantošanas ir jārestartē pārlūkprogramma.</translation>
<translation id="8799570501820813406">Kamēr šī cilne bija neaktīva, tika atbrīvota atmiņa pārlūka Freedom ātrākai darbībai. Varat izvēlēties vienmēr saglabāt šo vietni aktīvu.</translation>
<translation id="8767381092474532098">Pārlūkā Freedom šī lejupielāde tika bloķēta, jo fails ir bīstams.</translation>
<translation id="3256289531845594061">Ja pierakstāties Freedom pakalpojumos, piemēram, Gmail vai YouTube, ar kontu <ph name="USER_EMAIL"/>, varat automātiski pierakstīties pārlūkā Freedom ar to pašu kontu.</translation>
<translation id="1290883685122687410">Iestatīšanas kļūda: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="4798342026247191171">Jaunā Freedom profila iestatīšana</translation>
<translation id="878572309106296578">Pārlūkam Freedom ir nepieciešama Bluetooth piekļuve, lai atrastu Bluetooth ierīces. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">Valodas noteikšana</translation>
<translation id="108284536240904209">Dzēst arī datus no pārlūka Freedom (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Piesprausts! Varat atkal piekļūt funkcijai Attēlu meklēšana, izmantojot jauno pogu rīkjoslā.</translation>
<translation id="1356661055722410047">Jaunums! Varat tulkot gan ekrānā redzamo tekstu, gan attēlus.</translation>
<translation id="1383876407941801731">Meklēt</translation>
<translation id="7009295044271335553">&amp;Pārvaldīt Freedom profilus</translation>
<translation id="8132634101975074716">Esat pierakstījies operētājsistēmā Freedom!</translation>
<translation id="141901961143729572">Dalieties domās!</translation>
<translation id="3880714039086599943">Lai kopīgotu logu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Freedom.</translation>
<translation id="1586284627848250203">Saņemt palīdzību saistībā ar Freedom for Testing</translation>
<translation id="1497802159252041924">Instalēšanas kļūda: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Šī lapa ir aizsargāta</translation>
<translation id="5147525139567260139">Freedom cilnes kopīgošana</translation>
<translation id="1547469039832541117">Tiek pabeigts atzīmētais uzdevums.</translation>
<translation id="1530633922026945685">Pārlūkam Freedom ir nepieciešama atļauja piekļūt jūsu kamerai, lai varētu izveidot jūsu apkārtnes 3D karti</translation>
<translation id="9125033103884432">{NUM_EXTENSIONS,plural, =1{Šis paplašinājums vairs netiek atbalstīts. Freedom iesaka to noņemt.}zero{Šie paplašinājumi vairs netiek atbalstīti. Freedom iesaka tos noņemt.}one{Šie paplašinājumi vairs netiek atbalstīti. Freedom iesaka tos noņemt.}other{Šie paplašinājumi vairs netiek atbalstīti. Freedom iesaka tos noņemt.}}</translation>
<translation id="51545890371361355">Piespraust pārlūku Freedom</translation>
<translation id="6570689355868013775">Freedom drošības rīki</translation>
<translation id="1902837727299679178">Freedom pieprasa dzēst jūsu paroļu pārvaldnieka datus. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="4449148723378534338">Pārskatiet svarīgākās konfidencialitātes un drošības vadīklas pārlūkā Freedom.</translation>
<translation id="1640672724030957280">Notiek lejupielāde...</translation>
<translation id="1680687534629375545">Jautāt attēlu meklēšanas funkcijai par šo lapu</translation>
<translation id="1709772298389099340">Nodrošina augstas privilēģijas pārlūkam <ph name="BROWSER_NAME"/>.</translation>
<translation id="2913217021115517297">Lai palīdzētu uzlabot šīs funkcijas, pārlūks Freedom nosūta Freedom serveriem datus par jūsu mijiedarbību ar tām. Šos datus var lasīt, apstrādāt un anotēt pārskatītāji.</translation>
<translation id="1722488837206509557">Tādējādi varēsiet atlasīt kādu no pieejamām ierīcēm un parādīt tajā saturu.</translation>
<translation id="8004287232784878841">Pārlūkā Freedom drīz tiks dzēsti pārlūkošanas dati</translation>
<translation id="4197839351786449392">Pārlūkā Freedom tiks mēģināts navigācijai izmantot HTTPS.</translation>
<translation id="7814200940910057384">Freedom dati dzēsti</translation>
<translation id="9048361966237194186">Pārlūks Freedom tiks restartēts pēc: <ph name="REMAINING_TIME"/></translation>
<translation id="5524150602137990006">Ja HTTPS nav pieejams, pārlūkā Freedom bez brīdinājuma tiks izmantots nedrošs savienojums.</translation>
<translation id="6797402139308059782">Ļaut Freedom darboties fonā</translation>
<translation id="5875673934455379806">Pārinstalēt Freedom</translation>
<translation id="4529028207655448215">Freedom mēģina <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="1838374766361614909">Notīrīt meklēšanas vaicājumu</translation>
<translation id="3541642064306182066">Lai dzēstu pārlūkošanas datus tikai no šīs ierīces un paturētu tos Freedom kontā, <ph name="BEGIN_LINK"/>izrakstieties no Freedom<ph name="END_LINK"/>.</translation>
<translation id="4559627161887338743">Varat pārvaldīt Freedom kontus, kuros esat pierakstījies. Jūsu Freedom konti tiek izmantoti pārlūkā Freedom, Play veikalā, pakalpojumā Gmail un citur. Ja vēlaties pievienot kontu kādam citam, piemēram, ģimenes loceklim, pievienojiet jaunu personu savai <ph name="DEVICE_TYPE"/> ierīcei. <ph name="LINK_BEGIN"/>Uzziniet vairāk<ph name="LINK_END"/>.</translation>
<translation id="1862852878885210965">Meklēšana, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="1880677175115548835">Atlasīt tekstu</translation>
<translation id="4528406859989804913">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu Freedom dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME"/>. Varēsiet dzēst šos datus, izmantojot Freedom kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. Ja vēlaties, varat izveidot jaunu profilu, lai atsevišķi glabātu Freedom datus. <ph name="LEARN_MORE"/></translation>
<translation id="2207454583030080759">Pārlūkā Freedom tiek taupīta akumulatora enerģija, ierobežojot darbības fonā un vizuālos efektus, piemēram, vienmērīgu ritināšanu un video kadru nomaiņas ātrumu. Varat <ph name="BEGIN_LINK"/>uzzināt vairāk par enerģijas taupīšanas režīmu<ph name="END_LINK"/>.</translation>
<translation id="1898804291554630487">Jautājiet par šo lapu</translation>
<translation id="8643267611122541711">Freedom atjauninātāja pakalpojums</translation>
<translation id="712480009194450642">Kamēr esat pierakstījies, pārlūkā Freedom varat izmantot savas paroles un citu saturu no Freedom konta. Iestatījumos varat jebkurā laikā mainīt šo iespēju.</translation>
<translation id="1649714546770135458">Ja izslēgsiet šo iestatījumu, varēsiet pierakstīties Freedom vietnēs, piemēram, pakalpojumā Gmail, nepierakstoties pārlūkā Freedom.</translation>
<translation id="916979339327923175">Noņemt šo lietotņu datus no Freedom</translation>
<translation id="189297655255130768">Freedom nereaģē. Vai restartēt to tūlīt?</translation>
<translation id="8422047647688939115">Saskaņā ar jūsu organizācijas (<ph name="MANAGER"/>) politiku jums ir jāpierakstās pārlūkā Freedom.</translation>
<translation id="4035053306113201399">Freedom OS ir jārestartē, lai lietotu atjauninājumu.</translation>
<translation id="9048754176089806686">Pārlūkā Freedom šī lejupielāde tika bloķēta, jo šī tipa faili parasti netiek lejupielādēti un var būt bīstami.</translation>
<translation id="1953553007165777902">Notiek lejupielāde... Atlikušais laiks: <ph name="MINUTE"/> minūte(-es).</translation>
<translation id="1775322105159056176">Freedom nevar noteikt vai iestatīt noklusējuma pārlūku.</translation>
<translation id="4372901050442507812">Uzzināt, kāpēc pārlūkā Freedom daži faili tiek bloķēti (saite tiks atvērta jaunā cilnē)</translation>
<translation id="2703425183860615504">Nodrošina Freedom programmatūras pastāvīgu atjaunināšanu. Ja šis pakalpojums tiks atspējots vai pārtraukts, jūsu Freedom programmatūra netiks pastāvīgi atjaunināta, kas nozīmē, ka nebūs iespējams labot drošības ievainojamības, ja tādas radīsies, turklāt var nedarboties funkcijas. Šis pakalpojums pats tiek atinstalēts, ja neviena Freedom programmatūra to neizmanto.</translation>
<translation id="9220324636239049437">Veicot šo darbību, no šīs ierīces tiks dzēsts 1 vienums. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Freedom kā <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Instalēšana neizdevās. Lūdzu, mēģiniet vēlreiz.</translation>
<translation id="831418749472885028">Lai pārbaudītu, vai jūsu pārējās paroles ir aizsargātas pret datu pārkāpumiem un citām drošības problēmām, <ph name="BEGIN_LINK"/>pierakstieties pārlūkā Freedom<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">Iestatījumi.</translation>
<translation id="5499149312981370855">Izvēlieties, vai iekļaut Freedom vēsturi, lai iegūtu personalizētākas iespējas Freedom pakalpojumos.</translation>
<translation id="5888420425384578947">Lai saņemtu turpmākus Freedom atjauninājumus, nepieciešama operētājsistēma macOS 12 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma macOS 11.</translation>
<translation id="2472891440303445472">Pārlūkā Freedom šī lejupielāde tika bloķēta, jo fails ir maldinošs un var veikt neparedzētas izmaiņas jūsu ierīcē.</translation>
<translation id="2726948994393234543">Jūsu paroles un citi Freedom dati, ko saglabājāt savā Freedom kontā, tiks noņemti no šīs ierīces. Lai atkal izmantotu šos datus pārlūkā Freedom, atkārtoti pierakstieties.</translation>
<translation id="4375530476448642348">{COUNT,plural, =1{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Freedom nav izmantots vienu minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}zero{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Freedom nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}one{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Freedom nav izmantots # minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}other{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Freedom nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}}</translation>
<translation id="2126108037660393668">Neizdevās verificēt lejupielādēto failu.</translation>
<translation id="2137162749895930932">Aizvērt tulkošanas ekrānu</translation>
<translation id="5789330946301045610">Pārlūkā Freedom šī lejupielāde tika bloķēta, jo vietnē netiek izmantots drošs savienojums un, iespējams, failā ir veiktas izmaiņas.</translation>
<translation id="142389341645668510">Pielāgot pārlūkprogrammu Freedom</translation>
<translation id="2174917724755363426">Instalēšana nav pabeigta. Vai tiešām vēlaties atcelt?</translation>
<translation id="8745514854244955877">Freedom — pierakstīšanās tīklā — <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Atjauninājumu pārbaudes kļūda: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="2058539073923004395">Noņemt kontu no pārlūka Freedom</translation>
<translation id="5550942974310218641">Saņemiet labāku aizsardzību, atrodoties ceļā, ar funkciju “Droša pārlūkošana ar papildu aizsardzību” pārlūkā Freedom operētājsistēmai iOS.</translation>
<translation id="6677253423995557759">Bīstama vietne. Pārlūkā Freedom tika noņemti paziņojumi.</translation>
<translation id="2236949375853147973">Manas darbības</translation>
<translation id="457168681575748148">Pierakstieties pārlūkā Freedom, lai varētu piekļūt adresēm un citiem datiem visās savās ierīcēs. Šī adrese tiks saglabāta jūsu Freedom kontā pēc pierakstīšanās.</translation>
<translation id="5659384504794665581">Ja jūsu datoru izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku Freedom atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos kontos.</translation>
<translation id="8984404842684436004">{NUM_TABS,plural, =1{Freedom iesaka pārtraukt tās cilnes darbību, kas palēnina pārlūka darbību}zero{Freedom iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}one{Freedom iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}other{Freedom iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}}</translation>
<translation id="2307973900865360088">Paturēt dokā</translation>
<translation id="7810992039564280750">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā Freedom. Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, Freedom var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="5042718521573656164">Veicot šo darbību, tiks ieviestas tālāk norādītās izmaiņas.
          <ph name="LINE_BREAKS"/>
           • Tiks atiestatīti noteikti Freedom iestatījumi un Freedom īsinājumtaustiņi.
           <ph name="LINE_BREAK"/>
           • Tiks atspējoti paplašinājumi.
           <ph name="LINE_BREAK"/>
           • Tiks dzēsti sīkfaili un citi vietņu pagaidu dati.
            <ph name="LINE_BREAKS"/>
           Grāmatzīmes, vēsture un saglabātās paroles netiks ietekmētas.</translation>
<translation id="9095263438435683933">Lai nosūtītu numuru no šejienes uz savu Android tālruni, abās ierīcēs pierakstieties pārlūkā Freedom.</translation>
<translation id="2356070529366658676">Vaicāt</translation>
<translation id="2359808026110333948">Turpināt</translation>
<translation id="6485997157403727556">Paplašinājums “<ph name="EXTENSION_NAME"/>” pieprasa, lai jūs pierakstītos pārlūkā Freedom</translation>
<translation id="7017760840808989683">Atspējot Freedom darbību fonā lietotnēm</translation>
<translation id="8491912023989916905">Lai izmantotu šo paplašinājumu kontā <ph name="USER_EMAIL_ADDRESS"/>, pierakstieties pārlūkā Freedom.</translation>
<translation id="8418845734693287262">Freedom OS nevarēja sinhronizēt jūsu datus, jo jūsu konta pierakstīšanās informācija ir novecojusi.</translation>
<translation id="5617265241715541684">{NUM_DEVICES,plural, =0{Vismaz viens Freedom paplašinājums piekļuva 1 HID ierīcei}=1{Vismaz viens Freedom paplašinājums piekļūst 1 HID ierīcei}zero{Vismaz viens Freedom paplašinājums piekļūst # HID ierīcēm}one{Vismaz viens Freedom paplašinājums piekļūst # HID ierīcei}other{Vismaz viens Freedom paplašinājums piekļūst # HID ierīcēm}}</translation>
<translation id="1248225940185478633">Pārlūkam Freedom ir nepieciešama atļauja izmantot kameru un mikrofonu šajā vietnē.</translation>
<translation id="2403703063067034158">Palaišanas kļūda: pašlaik ir aktīvs cits iestatīšanas process. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="2118275934191847461">Izmantojot <ph name="BEGIN_LINK"/>Freedom rīkus<ph name="END_LINK"/>, varat droši pārlūkot saturu un pārvaldīt jums pieejamās iespējas.</translation>
<translation id="2451727308784734061">Izmantojot saīsni, varat ātri piekļūt Freedom paroļu pārvaldniekam. Varat pārvietot saīsni uz datora sākuma ekrānu vai lietotņu palaidēju.</translation>
<translation id="6381750314821942592">Freedom drīz tiks aizvērts</translation>
<translation id="6078442581074612226">Pārlūkā Freedom</translation>
<translation id="2485422356828889247">Atinstalēt</translation>
<translation id="2513154137948333830">Nepieciešama atkārtota palaišana: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Atlasiet tekstu, ko meklēt, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="70183448213529602">Pārlūkā Freedom tiek mēģināts aizstāt esošās paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="7798069806040634998">Pārlūkam Freedom ir nepieciešama piekļuve krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="8447483940522230788">Freedom palīgs</translation>
<translation id="2575822587468774919">Atlasiet jebko, lai to meklētu, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="3830890663494219270">Pierakstieties pārlūkā Freedom, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="6252796827759111076">Turpināt lietot Freedom</translation>
<translation id="259935314519650377">Lejupielādēto instalēšanas programmu neizdevās saglabāt kešatmiņā. Kļūda: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Sistēma</translation>
<translation id="7931230852267968641">Jūsu organizācija var skatīt un pārvaldīt pārlūkošanas datus, piemēram, grāmatzīmes, vēsturi un paroles. Tā nevar skatīt pārlūkošanas datus citos Freedom profilos.</translation>
<translation id="2257221826278123061">Lai izmantotu un saglabātu Freedom datus savā kontā (<ph name="ACCOUNT_EMAIL"/>), apstipriniet savu identitāti.</translation>
<translation id="7788346643684168549">Freedom darbojas ātrāk, un funkcijas, kurās tiek izmantota valoda JavaScript, darbojas paredzētajā veidā (ieteicams)</translation>
<translation id="7387051847644272380">Instalācijas laikā radās operētājsistēmas kļūda. Lejupielādējiet Freedom vēlreiz.</translation>
<translation id="2648689842065142443">Ja ierīci izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku Freedom atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos profilos.</translation>
<translation id="6791166902140255175">Freedom cilne</translation>
<translation id="8372880274820509128">Papildu drošības nolūkos Freedom šifrēs jūsu datus.</translation>
<translation id="8752006915531191162">Lai noņemtu savu Freedom kontu no pārlūka Freedom, izrakstieties.</translation>
<translation id="5344406739101555055">Pierakstieties pārlūkā Freedom, lai varētu piekļūt parolēm, grāmatzīmēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="2738871930057338499">Nevar izveidot savienojumu ar internetu. HTTP 403 — aizliegts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="2753623023919742414">Noklikšķiniet, lai meklētu</translation>
<translation id="1312769823139326127">Iestatiet Freedom kā noklusējuma PDF failu skatītāju.</translation>
<translation id="2770231113462710648">Mainīt noklusējuma pārlūkprogrammu uz:</translation>
<translation id="1187986649024576560">Šis paplašinājums satur ļaunprātīgu programmatūru un nav drošs. Noņemiet to no pārlūka Freedom, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="2799223571221894425">Restartēt</translation>
<translation id="5962774139606909656">Jūsu Freedom</translation>
<translation id="2816462166102338036">Meklēt šo videoklipu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="2841525013647267359">Tulkot no šādas valodas:</translation>
<translation id="2846251086934905009">Instalēšanas kļūda: instalēšanas programma nepabeidza darbu. Instalēšana ir priekšlaikus pārtraukta.</translation>
<translation id="777113543093865885">Noņemšana no pārlūka Freedom...</translation>
<translation id="5265419033369521352">Tiek nodrošināta jūsu aizsardzība pārlūkprogrammā Freedom. Šis režīms var tikt izmantots jūsu drošības uzlabošanai citās Freedom lietotnēs, kad esat pierakstījies.</translation>
<translation id="2885378588091291677">Uzdevumu pārvaldnieks</translation>
<translation id="2176825726964012531">Par &amp;Freedom</translation>
<translation id="2915996080311180594">Restartēt vēlāk</translation>
<translation id="2928420929544864228">Instalēšana pabeigta.</translation>
<translation id="2481553173340651149">Jūsu dati ir šifrēti, izmantojot ieejas frāzi. Ievadiet ieejas frāzi, lai izmantotu un saglabātu Freedom datus savā Freedom kontā.</translation>
<translation id="2945997411976714835">Instalēšanas kļūda: neizdevās palaist instalēšanas programmu.</translation>
<translation id="2413255940314578781">Ātrāk pierakstieties vietnēs, izmantojot saglabātās paroles pārlūkam Freedom operētājsistēmā iOS.</translation>
<translation id="3688936822855019158">Pārlūku Freedom pārvalda jūsu organizācija</translation>
<translation id="8208853227947884571">Freedom ir atjaunināts</translation>
<translation id="5122472867956731189">Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, Freedom var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="3963199983793987097">Lai tiktu lietoti jūsu vecāka izvēlētie iestatījumi un jūs tiešsaistē saņemtu labāku aizsardzību, pierakstieties pārlūkā Freedom</translation>
<translation id="3003694935412297923">Visi uzdevumi</translation>
<translation id="4202995875619419215">Atveriet vietrādi <ph name="URL"/> jaunā cilnē pārlūkā Freedom.</translation>
<translation id="8755404239607088219">Pārlūkprogrammā Freedom nevar pārbaudīt jūsu paroles. Vēlāk mēģiniet vēlreiz.</translation>
<translation id="8880183781256147665">Notiek pievienošana pārlūkam Freedom...</translation>
<translation id="3038232873781883849">Gaida, lai instalētu...</translation>
<translation id="3045032126857188731">Tulkojuma valoda: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">Aizvērt atsauksmju dialoglodziņu</translation>
<translation id="4503085212612536713">Citi Freedom profili</translation>
<translation id="7918740962659365265">Palīdzēt uzlabot Freedom, nosūtot Freedom serveriem avāriju pārskatus un <ph name="UMA_LINK"/></translation>
<translation id="2332543193474246254">{NUM_DEVICES,plural, =0{Vismaz viens Freedom paplašinājums piekļuva 1 USB ierīcei}=1{Vismaz viens Freedom paplašinājums piekļūst 1 USB ierīcei}zero{Vismaz viens Freedom paplašinājums piekļūst # USB ierīcēm}one{Vismaz viens Freedom paplašinājums piekļūst # USB ierīcei}other{Vismaz viens Freedom paplašinājums piekļūst # USB ierīcēm}}</translation>
<translation id="3700405816184340252">Freedom vēsture</translation>
<translation id="7365690458036015383">Instalēšanas programmai neizdevās atarhivēt arhīvu. Lejupielādējiet Freedom vēlreiz.</translation>
<translation id="310459126943037700">Neizdevās pabeigt uzdevumus.</translation>
<translation id="8919461291440820124">Pārlūkā Freedom tiek izmantots jūsu mikrofons.</translation>
<translation id="3137969841538672700">Velciet, lai meklētu</translation>
<translation id="8372436892102763334">Šī cilne izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam Freedom padarīt to neaktīvu.</translation>
<translation id="5949068186379578553">Lai kopīgotu ekrānu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Freedom.</translation>
<translation id="4805806622840861220">Restartēt Freedom</translation>
<translation id="3161522574479303604">Visas valodas</translation>
<translation id="3225882094369124157">Cita datorā instalēta programma pievienoja motīvu, kas var ietekmēt pārlūka Freedom darbību.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1742948938503172561">Pielāgojiet savu jauno Freedom profilu.</translation>
<translation id="4805865169608137960">Lai noņemtu savu Freedom kontu no pārlūka Freedom, lapā “Iestatījumi” izrakstieties no pārlūka Freedom.</translation>
<translation id="1651639704310627074">Vēlāk pārlūkā Freedom var tikt vaicāts, vai vēlaties izmantot saglabāto informāciju veidlapu automātiskai aizpildei.</translation>
<translation id="2585240446624043880">Freedom nevar nolasīt savu datu direktoriju un ierakstīt tajā:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">Restartēt tūlīt</translation>
<translation id="2339258256897053758">Trūkst Freedom API atslēgu. Tiks atspējotas dažas Freedom funkcijas.</translation>
<translation id="8926637909431618259">Turpināt lietotņu izpildi fonā, kad Freedom ir aizvērts</translation>
<translation id="518125528057094977">Pārlūkā Freedom tiks parādīts brīdinājums pirms jebkuras vietnes ielādes, izmantojot nedrošu savienojumu.</translation>
<translation id="8652321858775514885">Aizverot visus Freedom logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no Freedom konta, ja esat pierakstījies pārlūkā Freedom. Lai atļautu vietnēm jūs atcerēties, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="3352986031709923790">meklēšanas apgabala augšējais labais stūris: <ph name="RIGHT"/>% pa labi, <ph name="TOP"/>% augšdaļā</translation>
<translation id="7261356974224431851">Freedom dati jūsu kontā</translation>
<translation id="3369405342922656244">Meklēt šajā lapā, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="2645435784669275700">Freedom OS</translation>
<translation id="2297290224191497273">Vai pāriet uz esošo Freedom profilu?</translation>
<translation id="3412460710772753638">Tā tiks atjaunināta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="7304389940068374923">Notiek Freedom pielāgošana…</translation>
<translation id="9216183508558772570">Ja pierakstīsieties ar uzlauztu paroli, pārlūkprogrammā Freedom tiks parādīts paziņojums</translation>
<translation id="5853262807109651878">Veicot šo darbību, no šīs ierīces tiks dzēsts(-i) <ph name="ITEMS_COUNT"/> vienums(-i). Lai vēlāk izgūtu datus, pierakstieties pārlūkā Freedom kā <ph name="USER_EMAIL"/>.</translation>
<translation id="2024972335338126423">Lai pārslēgtos starp Freedom profiliem, izmantojiet īsinājumtaustiņu <ph name="SHORTCUT"/>.</translation>
<translation id="8703492925273919597">Aizveriet visus Freedom logus un mēģiniet vēlreiz.</translation>
<translation id="599091950194451698">Lai kopīgotu logu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Freedom.</translation>
<translation id="1447863765638888625">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER"/>.  Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Freedom savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="8981774130895723211">Lai kopīgotu ekrānu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Freedom.</translation>
<translation id="3597003331831379823">Neizdevās izpildīt iestatīšanu ar augstām privilēģijām. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="3066805437003400520">Šī lietotāja pārlūkošanas dati tiks dzēsti no šīs ierīces. Lai atkoptu datus, pierakstieties pārlūkprogrammā Freedom kā lietotājs <ph name="USER_EMAIL"/>.</translation>
<translation id="7029305463989165490">Lai nosūtītu numuru no vietnes <ph name="ORIGIN"/> uz savu Android tālruni, abās ierīcēs pierakstieties pārlūkā Freedom.</translation>
<translation id="3667616615096815454">Nevar instalēt. Lietojumprogramma serverim nav zināma.</translation>
<translation id="1128485277465085828">Izmantot jūsu <ph name="BEGIN_LINK"/>ieejas frāzi<ph name="END_LINK"/> visu Freedom datu šifrēšanai jūsu Freedom kontā. Maksājumu veidi un adreses no pakalpojuma Freedom Pay netiks šifrētas. Pārlūkā Freedom saglabātā pārlūkošanas vēsture netiks sinhronizēta.</translation>
<translation id="4304059894777924102">Pārlūkprogrammā Freedom nevar pārbaudīt jūsu paroles. Pārbaudiet interneta savienojumu.</translation>
<translation id="1807774211756215222">Atvērt saiti jaunā Freedom &amp;cilnē</translation>
<translation id="387105482057676379">Saistiet pārlūku Freedom un citus Freedom pakalpojumus personalizēšanai un citiem mērķiem</translation>
<translation id="3867175562099983425">Pārvaldīt Freedom profilus</translation>
<translation id="308146532933302843">Uzziniet, kāpēc Freedom bloķē noteiktas lejupielādes</translation>
<translation id="2189149060536531804">Ja kaut kas būs jāpārskata, saņemsiet Freedom paziņojumu</translation>
<translation id="6324134303015966238">Pārlūkā Freedom tiek iepriekš ielādētas lapas, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="3810973564298564668">Pārvaldīt</translation>
<translation id="3846683726093018685">**Apkopošana:** vienā teikumā, kas nepārsniedz 30 vārdus, aprakstiet ekrānuzņēmumā redzamā satura galveno tēmu un nolūku.

          **Jautājumu ieteikšana:** ģenerējiet sarakstu ar aizzīmēm ar 3–5 jautājumiem, kas liek aizdomāties un kurus lietotājs varētu uzdot, lai labāk izprastu ekrānuzņēmumu. Šajos jautājumos ir jābūt vismaz vienam jautājumam, kas ir saistīts ar vizuālu objektu, tā dizainu vai izvietojumu.</translation>
<translation id="5381622442243174305"><ph name="PAGE_TITLE"/> — Freedom</translation>
<translation id="3885770153807205175">Valodas atlasītājs</translation>
<translation id="6315734375101223238">Pielāgojiet un kontrolējiet pārlūkprogrammu Freedom. Ir nepieciešama jūsu uzmanība. Noklikšķiniet, lai skatītu plašāku informāciju.</translation>
<translation id="7130675370997202556">Noklikšķiniet uz sava vārda, lai atvērtu Freedom un sāktu pārlūkošanu.</translation>
<translation id="3892148308691398805">Kopēt tekstu</translation>
<translation id="4920958997042285125">Lietotājs <ph name="EXISTING_USER"/> jau ir pierakstījies šajā Freedom profilā. Lai atdalītu pārlūkošanu, pārlūkā Freedom varat sev izveidot atsevišķu profilu.</translation>
<translation id="8744239658215739511">P&amp;ielāgot pārlūku Freedom</translation>
<translation id="3941890832296813527">Instalēšanas kļūda: instalēšanas programmas faila nosaukums nav derīgs vai netiek atbalstīts.</translation>
<translation id="8090497651549769448">Freedom mēģina nokopēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="4256965182800026277">Jūsu Freedom kontā saglabātās paroles, maksājuma veidi un adreses tiks noņemtas no šīs ierīces. Lai atkal izmantotu šos datus pārlūkā Freedom, atkārtoti pierakstieties.</translation>
<translation id="395904275706073188">Aizsargātas lapas nevar lasīt. Izmēģiniet citu lapu.</translation>
<translation id="4194619960643453552">Uzziniet, kā Freedom rūpējas par jūsu drošību</translation>
<translation id="1486377520191913768">Kad rakstāt adreses joslā vai meklēšanas lodziņā, pārlūks Freedom nosūta rakstīto tekstu jūsu organizācijas meklēšanas, MI un starpnieku rīkiem, lai iegūtu ieteikumus.</translation>
<translation id="1311808042904310985">Par Freedom for Testing</translation>
<translation id="1152920704813762236">Par Freedom OS</translation>
<translation id="3703994572283698466">Freedom OS, kā arī <ph name="BEGIN_LINK_LINUX_OSS"/>Linux izstrādes vides<ph name="END_LINK_LINUX_OSS"/> darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS"/>atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="4022972681110646219">Tulkot ekrāna tekstu</translation>
<translation id="4023601594785368013">Oriģinālvaloda: <ph name="LANGUAGE"/></translation>
<translation id="5540160525564738506">Atveriet saites pārlūkā Freedom no jebkuras lietotnes. Turklāt pārlūks tiks piesprausts uzdevumjoslā, lai nodrošinātu ērtāku piekļuvi.</translation>
<translation id="6056473803837713617">Palīdziet uzlabot pārlūku Freedom, ziņojot par <ph name="BEGIN_LINK"/>pašreizējiem iestatījumiem<ph name="END_LINK"/>.</translation>
<translation id="4050175100176540509">Jaunākajā versijā ir pieejami svarīgi drošības uzlabojumi un jaunas funkcijas.</translation>
<translation id="4055805654398742145">P&amp;aroļu pārvaldnieks</translation>
<translation id="6654312501894761082">Cita datorā instalēta programma pievienoja paplašinājumu, kas var ietekmēt pārlūka Freedom darbību.

<ph name="EXTENSION_NAME"/></translation>
<translation id="6217792792122501564">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku Freedom, ja tas nav izmantots vienu minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}zero{Jūsu organizācija automātiski aizver pārlūku Freedom, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}one{Jūsu organizācija automātiski aizver pārlūku Freedom, ja tas nav izmantots # minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}other{Jūsu organizācija automātiski aizver pārlūku Freedom, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}}</translation>
<translation id="5794951150713244901">Pāriet uz lapu “Par Freedom”</translation>
<translation id="6596295505984504022">P&amp;ielāgot pārlūku Freedom</translation>
<translation id="4148957013307229264">Notiek instalēšana...</translation>
<translation id="4658486203392098459"><ph name="PAGE_TITLE"/> — pierakstīšanās tīklā — Freedom</translation>
<translation id="2871190378186459992">Atklājiet lieliskas lietotnes, spēles, paplašinājumus un motīvus, ko varat izmantot pārlūkā Freedom.</translation>
<translation id="462105622535258178">Lai piekļūtu šim paplašinājumam un citiem datiem visos savos datoros, pierakstieties pārlūkā Freedom.</translation>
<translation id="6670140629169983459">Lai tiktu lietoti jūsu vecāka izvēlētie iestatījumi un jūs tiešsaistē saņemtu labāku aizsardzību, pārslēdzieties uz Freedom profilu, kurā jau pierakstījāties ar kontu <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="4222932583846282852">Notiek atcelšana...</translation>
<translation id="4224210481850767180">Instalēšana ir atcelta.</translation>
<translation id="1853997773668795891">Vai saistīt Freedom datus ar šo kontu?</translation>
<translation id="4732930052828648898">Tiek rādīts brīdinājums par bīstamām vietnēm (pat ja Freedom par tām iepriekš nezināja), analizējot vairāk datu no vietnēm, nekā analizē standarta aizsardzība. Varat izlaist Freedom brīdinājumus.</translation>
<translation id="2201661640076600072">Izrakstīties no pārlūka Freedom</translation>
<translation id="3262506503470845422">Saņemt palīdzību par Freedom</translation>
<translation id="4281844954008187215">Freedom pakalpojumu noteikumi</translation>
<translation id="7691786510374174420">Instalācija neizdevās nenoteiktas kļūdas dēļ. Ja Freedom šobrīd darbojas, aizveriet to un mēģiniet vēlreiz.</translation>
<translation id="6368144843345980623">Paroļu eksportēšana no pārlūka Freedom</translation>
<translation id="4304713468139749426">Paroļu pārvaldnieks</translation>
<translation id="4334241893986177674">Meklēt šajā ekrānuzņēmumā</translation>
<translation id="4334294535648607276">Lejupielāde pabeigta.</translation>
<translation id="1068681683510904753"><ph name="MANAGER"/> pieprasa, lai pirms šīs ierīces lietošanas jūs izlasītu tālāk sniegtos pakalpojumu sniegšanas noteikumus un piekristu tiem. Šie noteikumi nepaplašina, nepārveido un neierobežo operētājsistēmas Freedom OS noteikumus.</translation>
<translation id="9183662282810237335">Vai tik un tā aizvērt pārlūku Freedom?</translation>
<translation id="4413205837991854510">Vienmēr rādīt funkcijas Attēlu meklēšana saīsni</translation>
<translation id="4065288863231444640">Ļaut pārlūkam Freedom darboties fonā</translation>
<translation id="1749140836512789834">{NUM_EXTENSIONS,plural, =1{Freedom iesaka to noņemt. <ph name="BEGIN_LINK"/>Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK"/>.}zero{Freedom iesaka tos noņemt. <ph name="BEGIN_LINK"/>Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK"/>.}one{Freedom iesaka tos noņemt. <ph name="BEGIN_LINK"/>Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK"/>.}other{Freedom iesaka tos noņemt. <ph name="BEGIN_LINK"/>Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK"/>.}}</translation>
<translation id="8148611988012584308">Pielāgot un kontrolēt Freedom</translation>
<translation id="4427306783828095590">Uzlabotā aizsardzība labāk bloķē pikšķerēšanas mēģinājumus un ļaunprātīgu programmatūru</translation>
<translation id="4434353761996769206">Instalēšanas kļūda: <ph name="INSTALLER_ERROR"/></translation>
<translation id="175926951572479413">Pārlūku Freedom pārvalda organizācija “<ph name="MANAGER"/>”</translation>
<translation id="3579012341787637143">Pievienot Freedom profilu</translation>
<translation id="6786534271003695094">Par Freedom for Testing</translation>
<translation id="526235294307144732">Lai izmantotu un saglabātu Freedom datus savā Freedom kontā, ievadiet ieejas frāzi.</translation>
<translation id="4493028449971051158">Palaišanas kļūda: lūdzu, palaidiet instalēšanas programmu kā administrators.</translation>
<translation id="4501471624619070934">Instalēšana neizdevās, jo šajā valstī piekļuve ir ierobežota.</translation>
<translation id="8594994021633965927">Nav norādīta konfidencialitātes prakse šim paplašinājumam, piemēram, kā tas vāc un izmanto datus. Freedom iesaka to noņemt.</translation>
<translation id="7084397798469173252">Laipni lūdzam pārlūkā Freedom (tika atvērts jauns pārlūka logs)!</translation>
<translation id="137732229629632648">Pārlūkam Freedom ir nepieciešama atļauja jūsu apkārtnes kartēšanai un roku kustību izsekošanai</translation>
<translation id="5917968343741192617">Freedom labāk izprot veidlapas un var ātrāk tās automātiski aizpildīt.</translation>
<translation id="5036046007335188949">Ar kontu <ph name="USER_EMAIL_ADDRESS"/> jau esat pierakstījies citā Freedom profilā</translation>
<translation id="1878185978731985193">Pārlūkā Freedom tiek iepriekš ielādētas lapas, tādējādi paātrinot pārlūkošanu un meklēšanu. Varat <ph name="BEGIN_LINK"/>uzzināt vairāk par lapu iepriekšēju ielādi<ph name="END_LINK"/>.</translation>
<translation id="4567424176335768812">Jūs esat pierakstījies kā <ph name="USER_EMAIL_ADDRESS"/>. Tagad varat piekļūt savām grāmatzīmēm, vēsturei un citiem iestatījumiem visās ierīcēs, kurās esat pierakstījies.</translation>
<translation id="8669339108356170796">Pārlūkā Freedom šī lejupielāde tika bloķēta, jo jūs izslēdzāt drošu pārlūkošanu un failu nevar verificēt.</translation>
<translation id="4594305310729380060">Tā tiks saglabāta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="300669147395456190">Freedom lietotnes</translation>
<translation id="4598116752460667024">Sarakstā meklējiet jebkuru procesu.</translation>
<translation id="4970880042055371251">Freedom OS versija</translation>
<translation id="2182657378556811785">Atjaunināšana ir gandrīz pabeigta. Lai pabeigtu atjaunināšanu, atkārtoti palaidiet pārlūku Freedom.</translation>
<translation id="6311668361877328515">Paātrina vietņu darbību, izmantojot Freedom programmu V8, taču nedaudz samazina Freedom izturību pret uzbrukumiem.</translation>
<translation id="7843665350820058984">Freedom labāk izprot veidlapas un var ātrāk tās automātiski aizpildīt. Šis iestatījums ir ieslēgts.</translation>
<translation id="7402642357351265733">Ja kopīgojat arī Freedom lietojuma pārskatus, šajos pārskatos tiek iekļauti jūsu apmeklētie vietrāži URL.</translation>
<translation id="8142245354207161805">Šķiet, ka profils tiek izmantots citā Freedom procesā (<ph name="PROCESS_ID"/>) citā datorā (<ph name="HOST_NAME"/>). Lai profils netiktu bojāts, pārlūkā Freedom tas ir bloķēts. Ja esat pārliecināts, ka šis profils netiek izmantots citos procesos, varat to atbloķēt un restartēt pārlūku Freedom.</translation>
<translation id="4680828127924988555">Atcelt instalēšanu</translation>
<translation id="2014343159590733363">Noteikti jūsu Freedom dati vēl nav saglabāti jūsu Freedom kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati tiks dzēsti.</translation>
<translation id="2408746614080689238">Kamēr esat pierakstījies, pārlūkā Freedom varat izmantot savas paroles un citu saturu no Freedom konta. <ph name="SHORTCUT"/> var mainīt jūsu Freedom pakalpojumu iestatījumus.</translation>
<translation id="847561904663814268">Kāds iepriekš pierakstījās pārlūkā Freedom šajā datorā, izmantojot e-pasta adresi <ph name="ACCOUNT_EMAIL_LAST"/>. Lūdzu, izveidojiet jaunu Freedom lietotāju, lai nošķirtu savu informāciju.</translation>
<translation id="4724676981607797757">Instalēšana neizdevās, jo radās neatbalstīta protokola kļūda.</translation>
<translation id="3834935463915107022">Vai tik un tā aizvērt pārlūku Freedom?</translation>
<translation id="8668413672647811944">Tikko tika piemērots īpašs Freedom drošības atjauninājums. Restartējiet tūlīt, un mēs atjaunosim jūsu cilnes.</translation>
<translation id="4941816441131888792">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Freedom tika noņemtas šādas atļaujas: <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> un vēl <ph name="COUNT"/>.</translation>
<translation id="4823369970559443694">Pārlūkprogrammā Freedom nevar pārbaudīt jūsu paroles. Mēģiniet vēlreiz pēc 24 stundām vai <ph name="BEGIN_LINK"/>pārbaudiet paroles savā Freedom kontā<ph name="END_LINK"/>.</translation>
<translation id="215320507915280336">Šeit tiek izmantota tāds pats pareizrakstības pārbaudītājs, kāds tiek izmantots Freedom meklēšanā. Pārlūkprogrammā ievadītais teksts tiek nosūtīts Freedom serveriem. Jebkurā brīdī varat mainīt šo darbību iestatījumos.</translation>
<translation id="2899369907387169108">Izmantot Freedom, nepierakstoties kontā</translation>
<translation id="1912973375560256099">Ienākošo savienojumu kārtula pārlūkam Freedom, lai atļautu mDNS datplūsmu.</translation>
<translation id="711601904575862069">Atkārtoti palaist, lai atjauninātu &amp;Freedom</translation>
<translation id="4918844574251943176">Attēls ir nokopēts</translation>
<translation id="8797356639448065696">Freedom darbojas fona režīmā.</translation>
<translation id="1895567721497166950">Noklikšķiniet, lai aizvērtu Freedom pierakstīšanās dialoglodziņu</translation>
<translation id="2692971232706994729">Izmantojot Freedom profilus, varat nodalīt visu savu Freedom saturu. Izveidojiet profilus draugiem un ģimenes locekļiem vai nodaliet darba un izklaides saturu.</translation>
<translation id="7406627712452599344">Viesi var izmantot Freedom, neatstājot nekādas pēdas.</translation>
<translation id="844471735881341044">Jūsu konts pārlūkā Freedom</translation>
<translation id="5952898964075639679">Pievienot savu kontu pārlūkā Freedom</translation>
<translation id="1204184037023366446">Pārlūkam Freedom ir nepieciešama atļauja izsekot jūsu roku kustības.</translation>
<translation id="5406591571925937375">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Freedom tika noņemtas šādas atļaujas: <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/>.</translation>
<translation id="5174969993834422967">Parasti jūs bloķējat paziņojumus. Lai ļautu šai vietnei sūtīt jums paziņojumus, noklikšķiniet uz paziņojumu ikonas atrašanās vietas joslas labajā stūrī.</translation>
<translation id="5174983315706567306">Diskā nepietiek brīvas vietas.</translation>
<translation id="8157129267754368853">Freedom kontam nepieciešama atkārtota autentifikācija</translation>
<translation id="9078804073692109646">Nav saglabātu paroļu. Pārlūkprogrammā Freedom var pārbaudīt jūsu paroles, ja jūs tās saglabājat.</translation>
<translation id="6234515504547364178">Izrakstīšanās no Freedom</translation>
<translation id="5234764350956374838">Nerādīt</translation>
<translation id="5254739261293693943">Uzdot jautājumus par šo videoklipu</translation>
<translation id="8586264863973514035">Lai ieviestu veiktās izmaiņas, atkārtoti palaidiet pārlūku Freedom.</translation>
<translation id="5286907366254680517">Noteiktā valoda</translation>
<translation id="6944930779012811739">Freedom atjauninātājs: iekšējais pakalpojums</translation>
<translation id="7573068992266397941">Pārlūkā Freedom tika atrasti daži drošības ieteikumi par jūsu atsauksmi</translation>
<translation id="8174413867995118050">Citi Freedom profili</translation>
<translation id="7708394612738038097">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu Freedom dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME"/>. Varēsiet dzēst šos datus, izmantojot Freedom kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">Papildu kods: <ph name="EXTRA_CODE"/>.</translation>
<translation id="2487133103111559902">Lai izmantotu personalizēšanu, iekļaujiet pārlūku Freedom iestatījumā “Darbības tīmeklī un lietotnēs”</translation>
<translation id="5154625106151193600">Uzzināt, kāpēc pārlūkā Freedom daži faili tiek bloķēti</translation>
<translation id="1786715389543715322">Notiek Freedom atjaunināšana (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="7021823858304886493">Atļaut pierakstīties pārlūkā Freedom</translation>
<translation id="5267531627648004734">Noņemt no pārlūka Freedom</translation>
<translation id="4620757336635063467">Samazina veiktspēju, taču uzlabo Freedom izturību pret uzbrukumiem.</translation>
<translation id="239760341987199724">Iestatīt Freedom kā noklusējuma pārlūku</translation>
<translation id="1403270718080126244"><ph name="PAGE_TITLE"/> — Freedom beta versija</translation>
<translation id="604223321106006231">{NUM_TABS,plural, =1{Freedom iesaka pārtraukt tās cilnes darbību, kas palēnina pārlūka darbību}zero{Freedom iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}one{Freedom iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}other{Freedom iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}}</translation>
<translation id="894936507076470937">Iespējams, pārlūks Freedom nedarbosies pareizi, jo tas vairs netiek atbalstīts šajā Linux izdevumā.</translation>
<translation id="2596557398669145729">Pārlūkā Freedom šī lejupielāde tika bloķēta, jo šis fails var kaitēt jūsu personīgajiem un sociālo tīklu kontiem</translation>
<translation id="696826782632239602">Pārlūkam Freedom ir nepieciešama piekļuve jūsu atrašanās vietas datiem, lai varētu tos kopīgot ar šo vietni.</translation>
<translation id="1744365871163268756">Lūdzu, uzgaidiet, kamēr Freedom instalē jaunākos sistēmas atjauninājumus.</translation>
<translation id="3861679447659630159">Freedom mēģina rediģēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="5524890928877629608">meklēšanas apgabala augšējais kreisais stūris: <ph name="LEFT"/>% pa kreisi, <ph name="TOP"/>% augšdaļā</translation>
<translation id="232381795826373334">Atvērt PDF failus pārlūkā Freedom</translation>
<translation id="5579324208890605088">Palaišanas kļūda: lūdzu, palaidiet instalēšanas programmu kā parasts lietotājs, nevis kā administrators.</translation>
<translation id="3588973534877826647">Izmantojiet pārlūku Freedom pēc noklusējuma un piespraudiet to</translation>
<translation id="5596627076506792578">Citas opcijas</translation>
<translation id="5605834417512968703">Atlasiet jebko, ko vēlaties meklēt, izmantojot funkciju Attēlu meklēšana, vai nospiediet atsoļa taustiņu, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="5618818588972826921">Atlasiet jebkuru tekstu vai attēlu, lai to meklētu, izmantojot funkciju Attēlu meklēšana, vai nospiediet atsoļa taustiņu, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="1026406809507858026">{0,plural, =0{Ir pieejams Freedom atjauninājums}=1{Ir pieejams Freedom atjauninājums}zero{Freedom atjauninājums ir pieejams jau # dienu}one{Freedom atjauninājums ir pieejams jau # dienu}other{Freedom atjauninājums ir pieejams jau # dienas}}</translation>
<translation id="1023472437588692618">Vienmēr notīrīt vietnes datus no ierīces, kad tiek aizvērts pārlūks Freedom</translation>
<translation id="5646769069113654257">Lūdzu, nekavējoties restartējiet pārlūku Freedom</translation>
<translation id="3117204675033805491">Freedom LLC</translation>
<translation id="2335583906071111058">Rādīt Freedom šajā valodā</translation>
<translation id="569897634095159764">Nevar izveidot savienojumu ar internetu. Starpniekserverī ir nepieciešama autentifikācija.</translation>
<translation id="1834213228893578875">Pārlūkā Freedom neaktīvās cilnēs tiek atbrīvota atmiņa. Tādējādi aktīvajām cilnēm un citām lietotnēm tiek nodrošināts vairāk datora resursu un tiek uzlabots Freedom darbības ātrums. Neaktīvās cilnes atkal tiek automātiski aktivizētas, kad tās atverat. Varat <ph name="BEGIN_LINK"/>uzzināt vairāk par atmiņas taupīšanas režīmu<ph name="END_LINK"/>.</translation>
<translation id="899523323751802352">Ja aizmirsāt ieejas frāzi vai vēlaties mainīt šo iestatījumu, varat <ph name="SETTINGS_LINK"/> Freedom datus savā kontā.</translation>
<translation id="82926023981336111">Pielāgojiet un kontrolējiet pārlūku Freedom. Iestatiet Freedom kā noklusējuma pārlūku.</translation>
<translation id="5809516625706423866">Nevar izveidot savienojumu ar internetu. HTTP 401 — neatļauts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="95980832839683236">Paātrina vietņu darbību, izmantojot Freedom programmu V8, bet nedaudz samazina Freedom izturību pret uzbrukumiem. Šis iestatījums ir izslēgts.</translation>
<translation id="1224606669200461217">Lai izmantotu un saglabātu Freedom datus Freedom kontā, atjauniniet pārlūku Freedom.</translation>
<translation id="5824893331272123205">Nevarēja ielādēt šo paneli. Mēģiniet vēlreiz.</translation>
<translation id="7207456302801184289">Laipni lūdzam pārlūkā Freedom!</translation>
<translation id="5871205389137001634">Noklikšķiniet, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="8054200348483755053">Pārlūkā Freedom tika konstatēts, ka tālāk norādītie vienumi satur ļaunprātīgu programmatūru:</translation>
<translation id="3955583201925082436">Freedom regulāri pārbauda, vai pārlūkā ir atlasīti visdrošākie iestatījumi. Ja kaut kas būs jāpārskata, saņemsiet paziņojumu.</translation>
<translation id="5895138241574237353">Restartēt</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> — pierakstīšanās tīklā</translation>
<translation id="5924017743176219022">Notiek savienojuma izveide ar internetu...</translation>
<translation id="5941711191222866238">Minimizēt</translation>
<translation id="5768962901674164501">Lai varētu izmantot šo grāmatzīmi un citus datus visās savās ierīcēs, pierakstieties pārlūkā Freedom.</translation>
<translation id="5101892358689285100">Freedom personalizēšana</translation>
<translation id="5968400720580217226">MI režīms</translation>
<translation id="4357808717322635817">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku Freedom, ja tas nav izmantots vienu minūti.}zero{Jūsu organizācija automātiski aizver pārlūku Freedom, ja tas nav izmantots # minūtes.}one{Jūsu organizācija automātiski aizver pārlūku Freedom, ja tas nav izmantots # minūti.}other{Jūsu organizācija automātiski aizver pārlūku Freedom, ja tas nav izmantots # minūtes.}}</translation>
<translation id="3598551856834560515">Lai sāktu sinhronizēšanu, atjauniniet Freedom.</translation>
<translation id="6003112304606738118">Notiek lejupielāde... Atlikušais laiks: <ph name="HOURS"/> stunda(-as).</translation>
<translation id="6009821354356307391">Uzdot papildu jautājumu</translation>
<translation id="6040143037577758943">Aizvērt</translation>
<translation id="700488072601322385">Lai aizsargātu savus datus, ļaujiet pārlūkā Freedom atsaukt atļaujas vietnēm, ko pēdējā laikā neesat apmeklējis (paziņojumi netiks bloķēti)</translation>
<translation id="9071554113102421877">&amp;Atvērt pārlūkā Freedom</translation>
<translation id="6069027071882229820">Kopēt kā attēlu</translation>
<translation id="7861579472672677409">Paplašinājums <ph name="EXTENSION_NAME"/> ir pievienots pārlūkam Freedom</translation>
<translation id="3693188491491843187">Pārlūka Freedom darbības paātrināšana</translation>
<translation id="5849446944780602366">Pielāgojiet un pārvaldiet pārlūku Freedom. Ir pieejams atjauninājums.</translation>
<translation id="5711722515923392428">Ieslēgts • Freedom nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="6355366566986893068">Jūsu konts pārlūkā Freedom</translation>
<translation id="7433698744896946664">Atļaut paplašinājumam rādīt piekļuves pieprasījumus Freedom rīkjoslā</translation>
<translation id="4168372721886011198">Fails <ph name="FILE_NAME"/> ir bīstams, tādēļ Freedom to bloķēja.</translation>
<translation id="991182453936521413">Freedom drīz tiks aizvērts, un dati tiks izdzēsti</translation>
<translation id="4060970194201477024">Šeit varat pārslēgties starp Freedom profiliem.</translation>
<translation id="7815000350132166985">Ja atļaujat sīkfailus, pārlūks Freedom var tos izmantot iepriekšējai ielādei.</translation>
<translation id="6165508094623778733">Uzzināt vairāk</translation>
<translation id="5739368447874065758">Notīrīt Freedom datus savā kontā</translation>
<translation id="6685697979743742605">Šis fails var būt bīstams.<ph name="LINE_BREAK"/>Freedom var pārbaudīt šo lejupielādi, ja norādīsiet paroli. Informācija par failu tiek nosūtīta funkcijai “Freedom droša pārlūkošana”, taču faila saturs un parole paliek jūsu ierīcē.</translation>
<translation id="6182736845697986886">Instalēšana neizdevās, jo radās atjauninājumu servera iekšēja kļūda.</translation>
<translation id="4368341489795135329">Ierīcē <ph name="TARGET_DEVICE_NAME"/> pierakstieties pārlūkā Freedom un pēc tam vēlreiz mēģiniet veikt sūtīšanu.</translation>
<translation id="3038354906709778538">Cita datorā instalēta programma pievienoja lietotni, kas var ietekmēt pārlūka Freedom darbību.

<ph name="EXTENSION_NAME"/></translation>
<translation id="8320964054148936490">Šim datoram jau ir jaunākā Freedom versija. Ja programmatūra nedarbojas, atinstalējiet pārlūku Freedom un mēģiniet vēlreiz.</translation>
<translation id="3574823187131579180">{0,plural, =0{Pārlūks Freedom tūlīt tiks restartēts}=1{Pārlūks Freedom pēc 1 sekundes tiks restartēts}zero{Pārlūks Freedom pēc # sekundēm tiks restartēts}one{Pārlūks Freedom pēc # sekundes tiks restartēts}other{Pārlūks Freedom pēc # sekundēm tiks restartēts}}</translation>
<translation id="6239161312595354541">Jautāt attēlu meklēšanas funkcijai par šo videoklipu</translation>
<translation id="5980269616827212166">Pārlūkam Freedom ir nepieciešama atļauja piekļūt krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="7651600795135059130">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā Freedom.</translation>
<translation id="5019879183386042809">Padarīt Freedom par noklusējuma pārlūku</translation>
<translation id="7445061995866044926">Vai izrakstīties no Freedom?</translation>
<translation id="4659866260728515512">Šīs cilnes izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam Freedom padarīt tās neaktīvas.</translation>
<translation id="6806912298071949921">Pielāgot Freedom profilu</translation>
<translation id="3792238845239580301">Freedom profila nosaukšana</translation>
<translation id="5874208157501051620">Viens no paplašinājumiem pieprasa, lai jūs pierakstītos pārlūkā Freedom</translation>
<translation id="3561569806301739367">Fails <ph name="FILE_NAME"/> var būt bīstams, tādēļ Freedom to bloķēja.</translation>
<translation id="3205074487970075628">Freedom saitē tiek izmantota kamera.</translation>
<translation id="6327105987658262776">Atjauninājums nav pieejams.</translation>
<translation id="1819119299840995223">Tiek veikta cita darbība pārlūkā Freedom. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="8616874628011103667">Tagad pārlūkā Freedom ir vieglāk izmantot Freedom kontu, kā arī ir atvieglota lietošana datoros, ko izmanto vairākas personas.</translation>
<translation id="4264606872840545968">Freedom saīsne</translation>
<translation id="6890616081898535725">Pārlūkā Freedom šī lejupielāde tika bloķēta, jo fails parasti netiek lejupielādēts un var būt bīstams.</translation>
<translation id="335632367599648646">Vai tiešām vēlaties atinstalēt pārlūku Freedom?</translation>
<translation id="6375219077595103062">Saīsnes pievienošana paroļu pārvaldniekam</translation>
<translation id="6388799252195623474">palīdzēt man ar šo</translation>
<translation id="7920857181125123335">Lai turpinātu, pierakstieties pārlūkā Freedom ar kontu <ph name="EMAIL"/>. Tas nodrošinās jūsu organizācijas politiku ievērošanu.</translation>
<translation id="3256100650978957522">Freedom logotips datora ekrānā.</translation>
<translation id="6373767849825830651">Freedom ir tīmekļa pārlūks, kas darbina tīmekļa lapas un lietojumprogrammas zibenīgā ātrumā. Tas ir ātrs, stabils un ērti lietojams. Pārlūkojiet tīmekli vēl drošāk ar aizsardzību pret ļaunprātīgu programmatūru un pikšķerēšanu, kas iebūvēta pārlūkā Freedom.</translation>
<translation id="6436260184216827876">Funkcija Attēlu meklēšana nav pieejama. Vēlāk mēģiniet vēlreiz.</translation>
<translation id="2139300032719313227">Freedom OS restartēšana</translation>
<translation id="638302211119176182">Pārlūkā Freedom tiek iepriekš ielādēts vēl vairāk lapu, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="890319829408077946">Izslēgts • Freedom nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="1684121725014454063">Laipni lūdzam Freedom profilos!</translation>
<translation id="7906693299331092358">Noņemt kontu no pārlūka Freedom</translation>
<translation id="2675662665675552980">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku Freedom.</translation>
<translation id="648319183876919572">Droša pārlūkošana ar papildu aizsardzību nodrošina efektīvāku aizsardzību pret bīstamām vietnēm un lejupielādēm</translation>
<translation id="5590013613412457132">Atinstalēt Freedom</translation>
<translation id="7185585387858242335">Saīsnes tiek atvērtas pārlūkā Freedom</translation>
<translation id="3617744907966785605">Jūsu organizācija aizver pārlūku Freedom, ja tas <ph name="TIMEOUT_DURATION"/> netiek izmantots. Pārlūkošanas dati tika izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="8646609321956191980">Katrā profilā tiek glabāta attiecīgā Freedom profila informācija, piemēram, grāmatzīmes, vēsture, paroles un citi dati.</translation>
<translation id="6756656512757374876">Uzziniet vairāk par to, <ph name="BEGIN_LINK"/>kā pārlūkā Freedom tiek saglabāta jūsu datu konfidencialitāte<ph name="END_LINK"/>.</translation>
<translation id="3556601443414636547">Šī iestatījuma izmaiņas tiks lietotas pēc pārlūka Freedom restartēšanas.</translation>
<translation id="2535436634051789953">Varat pārslēgties, lai skatītu paroles no cita Freedom profila.</translation>
<translation id="2312399718665761438">Lai izlabotu pareizrakstības kļūdas, Freedom nosūta teksta laukos ievadīto tekstu Freedom serveriem.</translation>
<translation id="3507835409099344374">Pāriet uz Freedom paziņojumu iestatījumiem</translation>
<translation id="6600016381025017075">Meklēt informāciju par jebkuru šīs lapas satura daļu</translation>
<translation id="9156965752763025780">Izmaiņas stāsies spēkā, kad restartēsiet Freedom.</translation>
<translation id="3119017564683030312">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā Freedom tika atjaunotas cilnes no jūsu pēdējās sesijas. Varat to izslēgt lapā</translation>
<translation id="245693535809364497">Pārlūkam Freedom ir nepieciešama atļauja izmantot kameru, lai varētu izveidot jūsu apkārtnes 3D karti.</translation>
<translation id="9210457680074341078">Ja saglabāsiet grāmatzīmes arī Freedom kontā, varēsiet izsekot produktu cenām pārlūkā Freedom un saņemt paziņojumus par cenu kritumiem.</translation>
<translation id="6676384891291319759">Piekļūt internetam</translation>
<translation id="1363996462118479832">Freedom OS nevarēja sinhronizēt jūsu datus pierakstīšanās kļūdas dēļ.</translation>
<translation id="5324448127277983819">Freedom nodrošina lielāku kontroli pār jums rādītajām reklāmām un ierobežo informāciju, ko vietnes var uzzināt par jums, kad tās rāda jums personalizētas reklāmas.</translation>
<translation id="1257247502847251159">Pārlūkam Freedom ir nepieciešama atļauja izmantot mikrofonu šajā vietnē.</translation>
<translation id="6712881677154121168">Lejupielādes kļūda: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="1489465648257900784">Jūsu profilu nevar izmantot, jo tas ir no jaunākas Freedom versijas.

Dažas funkcijas var nebūt pieejamas. Norādiet citu profila direktoriju vai izmantojiet jaunāku Freedom versiju.</translation>
<translation id="1505112054322049777">Lai varētu izmantot personalizēšanu un citas funkcijas, iekļaujiet pārlūku Freedom iestatījumos “Darbības tīmeklī un lietotnēs” un “Saistītie Freedom pakalpojumi”.</translation>
<translation id="6666624454809779082">Pārlūks Freedom jau ir instalēts visiem lietotājiem jūsu datorā.</translation>
<translation id="4020203987234748583">Paātrina vietņu darbību, izmantojot Freedom programmu V8, bet nedaudz samazina Freedom izturību pret uzbrukumiem. Šis iestatījums ir ieslēgts.</translation>
<translation id="3136039682492230890">Freedom iesaka pārbaudīt šo failu, jo tas var būt bīstams.</translation>
<translation id="1547295885616600893">Freedom OS darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS"/>atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="6831043979455480757">Tulkot</translation>
<translation id="8211837073776713955">Ja jūsu paroles kādreiz tiks apdraudētas, pārlūkā Freedom saņemsiet paziņojumu</translation>
<translation id="684888714667046800">Nevar izveidot savienojumu ar internetu. Ja izmantojat ugunsmūri, failam <ph name="PRODUCT_EXE_NAME"/> noteikti ir jābūt iekļautam atļaušanas sarakstā.</translation>
<translation id="7830723774663008396">Freedom — <ph name="PAGE_TITLE"/></translation>
<translation id="6862030660799253820">Meklēt šo attēlu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="3028928628792374067">Pārlūkā Freedom tika konstatēts, ka paplašinājums “<ph name="EXTENSION_NAME"/>” satur ļaunprātīgu programmatūru.</translation>
<translation id="6877155553248388166">meklēšanas apgabala apakšējais labais stūris: <ph name="RIGHT"/>% pa labi, <ph name="BOTTOM"/>% apakšdaļā</translation>
<translation id="6896758677409633944">Kopēt</translation>
<translation id="862687584320433626">Iestatiet Freedom kā noklusējuma pārlūku un piespraudiet to uzdevumjoslai</translation>
<translation id="1991562568473125499">&amp;Pārvaldīt Freedom profilus</translation>
<translation id="6934579572334859869">Jautāt attēlu meklēšanas funkcijai par šo attēlu</translation>
<translation id="6965382102122355670">Labi</translation>
<translation id="6418340404893954563">Nedrošas paroles ir viegli uzminēt. Pārlūkā Freedom <ph name="BEGIN_LINK"/>var automātiski veidot un iegaumēt drošas paroles jūsu kontiem<ph name="END_LINK"/>.</translation>
<translation id="3453763134178591239">Freedom OS noteikumi</translation>
<translation id="3335606533094650083">Pārlūkam Freedom ir nepieciešama atļauja piekļūt jūsu mikrofonam šajā vietnē.</translation>
<translation id="6643520655691573653">Lai savā kontā (<ph name="ACCOUNT_EMAIL"/>) izmantotu un saglabātu Freedom datus, ievadiet ieejas frāzi.</translation>
<translation id="7011190694940573312">Instalēšana neizdevās, jo šī operētājsistēmas versija netiek atbalstīta.</translation>
<translation id="7024536598735240744">Atpakošanas kļūda: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">Instalēšana apturēta.</translation>
<translation id="280382502853897110">Pielāgojiet pārlūku Freedom savām vajadzībām</translation>
<translation id="7047386856539490735">Vai šie rezultāti ir noderīgi?</translation>
<translation id="1705567146636171298">Atjaunināt Freedom</translation>
<translation id="5499063270485366718">Ja attēlam nav vērtīga apraksta, pārlūks Freedom mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Freedom.</translation>
<translation id="5966368554860795750">Pielāgot versiju Freedom for Testing</translation>
<translation id="375314543563594498">Noņemt paplašinājumu <ph name="EXTENSION_NAME"/> no pārlūka Freedom</translation>
<translation id="2332301637111071062">Jūsu organizācija dzēš Freedom datus, ja šis pārlūks <ph name="TIMEOUT_DURATION"/> netiek izmantots. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="1008530050039597147">Pārlūkam Freedom ir nepieciešama atļauja izmantot kameru šajā vietnē.</translation>
<translation id="1197672524850678392">Neizdevās palaist Freedom. Mēģiniet vēlreiz.</translation>
<translation id="3405035915691517126">Pārlūkprogrammā Freedom nevar pārbaudīt jūsu paroles. Mēģiniet vēlreiz pēc 24 stundām.</translation>
<translation id="3625983487600668413">Paturiet pārlūku Freedom dokā, lai jebkurā laikā varētu tam ātri piekļūt.</translation>
<translation id="5755581833598928580">Izmantojiet Freedom ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs</translation>
<translation id="5516268345616100622">Uzdevumu pārvaldnieks — Freedom</translation>
<translation id="713191641919118540">Jūsu intereses, kas aptuveni noteiktas pārlūkā Freedom</translation>
<translation id="7274695763216404502">Piesprausts! Varat atkal piekļūt funkcijai Attēlu meklēšana no rīkjoslas.</translation>
<translation id="7288567540154601580">Cilnes un paplašinājumi</translation>
<translation id="5468053269968670855">{NUM_EXTENSIONS,plural, =1{Freedom iesaka to noņemt.}zero{Freedom iesaka tos noņemt.}one{Freedom iesaka tos noņemt.}other{Freedom iesaka tos noņemt.}}</translation>
<translation id="9068395155143628872">Reklāmu izvērtēšana ļauj jūsu apmeklētajām vietnēm pieprasīt informāciju no Freedom, lai efektīvāk novērtētu vietnēs rādīto reklāmu veiktspēju. Reklāmu izvērtēšana ierobežo starpvietņu izsekošanu, pārsūtot starp vietnēm pēc iespējas mazāk informācijas.</translation>
<translation id="1864557848095568223">Notiek Freedom atjaunināšana</translation>
<translation id="3403365884036456766">Jūsu preferenču fails ir bojāts vai nederīgs. Freedom nespēj atkopt jūsu iestatījumus.</translation>
<translation id="7339898014177206373">Jauns logs</translation>
<translation id="3511996232906761537">Šeit atrodas jūsu tīmekļa saturs, grāmatzīmes un cits Freedom saturs.</translation>
<translation id="1754899895078387289">Jūsu šifrētos datus var lasīt tikai personas, kurām ir jūsu ieejas frāze. Ieejas frāze netiek sūtīta uzņēmumam Freedom, un uzņēmums Freedom to neuzglabā. Ja aizmirsīsiet ieejas frāzi vai vēlēsieties mainīt šo iestatījumu, jums būs <ph name="BEGIN_LINK"/>jāizdzēš Freedom dati savā kontā<ph name="END_LINK"/>.</translation>
<translation id="5380963249588143069">Jūsu sistēmas administrators ir konfigurējis Freedom atvērt <ph name="ALTERNATIVE_BROWSER_NAME"/>, lai piekļūtu <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7352651011704765696">Radās problēma</translation>
<translation id="2865744782251083875">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Freedom tika noņemtas šādas atļaujas: <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>.</translation>
<translation id="4631170166710903214">Šis paplašinājums vairs netiek atbalstīts. Freedom iesaka to noņemt.</translation>
<translation id="7951152294775418909">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā Freedom tiek atjaunotas jūsu cilnes ikreiz, kad to restartējat. Lai to izslēgtu, pārejiet uz lapu</translation>
<translation id="3191314862567596053">Paroļu importēšana pārlūkā Freedom</translation>
<translation id="3943696263619956191"><ph name="PAGE_TITLE"/> — Freedom izstrādātāju versija</translation>
<translation id="7450541714075000668">Teksts ir nokopēts</translation>
<translation id="2034072705932785495">Pārlūkam Freedom ir nepieciešama atļauja piekļūt jūsu kamerai šajā vietnē.</translation>
<translation id="7129342855140808694">Lai izmantotu mikrofonu, piešķiriet pārlūkam Freedom piekļuvi <ph name="BEGIN_LINK"/>sistēmas iestatījumos<ph name="END_LINK"/>.</translation>
<translation id="5296583608321648908">Lai saņemtu turpmākus Freedom atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 7.</translation>
<translation id="3962395975456095331">Vai atkārtoti palaist Freedom?</translation>
<translation id="2619516027171717873">Nevar instalēt to pašu Freedom versiju, kas jau šobrīd darbojas. Aizveriet Freedom un mēģiniet vēlreiz.</translation>
<translation id="2731639583336131792">Jūs saglabāsiet un izmantosiet paroles un citu saturu savā Freedom kontā, kad vien būsiet pierakstījies pārlūkā Freedom. <ph name="LEARN_MORE"/></translation>
<translation id="5337027666828618338">Vietnes, visticamāk, darbosies, kā paredzēts. Aizverot visus Freedom logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no Freedom konta, ja esat pierakstījies pārlūkā Freedom.</translation>
<translation id="3186363903915641692">{0,plural, =1{Pārlūks Freedom pēc 1 minūtes tiks restartēts}zero{Pārlūks Freedom pēc # minūtēm tiks restartēts}one{Pārlūks Freedom pēc # minūtes tiks restartēts}other{Pārlūks Freedom pēc # minūtēm tiks restartēts}}</translation>
<translation id="552342471964912391">Lai aizsargātu savus datus, ļaujiet pārlūkā Freedom noņemt atļaujas vietnēm, ko pēdējā laikā neesat apmeklējis.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> instalēšanas programma</translation>
<translation id="3293668930608086049">Pārlūkā Freedom tiek izmantota jūsu kamera un mikrofons.</translation>
<translation id="2827121003398607864">Pārlūkā Freedom ir veikti uzlabojumi</translation>
<translation id="3071313329776323836">Tagad pārlūkā Freedom ir pieejams vairāk funkciju.</translation>
<translation id="7649070708921625228">Palīdzība</translation>
<translation id="7658239707568436148">Atcelt</translation>
<translation id="3343095737966473035">Freedom nav jūsu noklusējuma pārlūks.</translation>
<translation id="5477319665405831211">Freedom sinhronizēšana un personalizēšana visās savās ierīcēs</translation>
<translation id="2339273275658335597">Freedom atjauninājums</translation>
<translation id="7716950018788545737">Uzdevumi ir pabeigti.</translation>
<translation id="77283119132245232">Nodrošina sistēmas izsekošanas pakalpojumus pārlūkā <ph name="BROWSER_NAME"/>. Ja šis pakalpojums ir atspējots, pārlūka izveidotajos veiktspējas izsekošanas datos netiek ietverti sistēmas līmeņa notikumi, piemēram, konteksta maiņas un pavedienu gatavības notikumi.</translation>
<translation id="4784414698887946907">Veicot šo darbību, no šīs ierīces tiks dzēsti pārlūkošanas dati. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Freedom kā <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">Instalētājam neizdevās izveidot pagaidu katalogu. Lūdzu, pārbaudiet, vai diskā pietiek vietas un vai ir atļauja instalēt programmatūru.</translation>
<translation id="1978509466033734608">Pārlūka Freedom darbības paātrināšana</translation>
<translation id="6236814935154483927"><ph name="PAGE_TITLE"/> — Freedom Canary</translation>
<translation id="2684504034454188774">Neļaujiet personām, kurām ir piekļuve jūsu interneta datplūsmai, viegli skatīt jūsu apmeklētās vietnes. Freedom izmanto drošu savienojumu, lai meklētu vietnes IP adresi sistēmā DNS (domēnu nosaukumu sistēmā).</translation>
<translation id="7810005234485217901">Varat piespraust funkciju Attēlu meklēšana, lai ērti tai varētu piekļūt.</translation>
<translation id="1652855885539187849">Šajā ierīcē jau pastāv Freedom profils ar šādu kontu.</translation>
<translation id="7845233973568007926">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME"/> izmantošanas ir jārestartē dators.</translation>
<translation id="7963515534397191222">Nevarēja atjaunināt uz jaunāko Freedom versiju, tādēļ jūs nevarēsiet piekļūt jaunākajām funkcijām un drošības labojumiem.</translation>
<translation id="7872446069773932638">Notiek lejupielāde... Atlikušais laiks: <ph name="SECONDS"/> sekunde(-es).</translation>
<translation id="5545136190679883344">Ja aizmirstat ieejas frāzi vai vēlaties mainīt šo iestatījumu, <ph name="BEGIN_LINK"/>izdzēsiet Freedom datus savā kontā<ph name="END_LINK"/>.</translation>
<translation id="7877212753140190672">Jautāt par šo attēlu</translation>
<translation id="5687542525349822727">Iestatīt Freedom kā noklusējuma pārlūku</translation>
<translation id="6396151137840491551">Pārlūkā Freedom nedrošie savienojumi tiek automātiski jaunināti uz HTTPS, ja iespējams.</translation>
<translation id="2925193881330501265">Operētājsistēmā Freedom iepriekš pierakstījāties kā lietotājs <ph name="USER_EMAIL_ADDRESS"/>. Lai pierakstītos vēlreiz, lūdzu, izmantojiet to pašu kontu.</translation>
<translation id="3206789667839392126">Lejupielādējiet pārlūku Freedom savā tālrunī, lai nodrošinātu papildu aizsardzību, atrodoties ceļā.</translation>
<translation id="6915252145142862992">Šī ir Freedom papildu instalācija, un to nevar izmantot kā noklusējuma pārlūku.</translation>
<translation id="8004582292198964060">Pārlūkprogramma</translation>
<translation id="8010081455002666927">Noteikt automātiski</translation>
<translation id="7685904775439037072">Tiklīdz pārlūkam Freedom tiks sniegta piekļuve, vietnes varēs lūgt jums piekļuvi.</translation>
<translation id="3230755314472063687">Piespraudiet pārlūku Freedom uzdevumu joslai, lai jebkurā laikā varētu tam ātri piekļūt.</translation>
<translation id="80471789339884597">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME"/> izmantošanas ir jārestartē visas pārlūkprogrammas.</translation>
<translation id="8054112667659782652">Vienmēr rādīt funkcijas Attēlu meklēšana saīsni</translation>
<translation id="6175141682081019059">Atspējot Freedom darbību fonā lietotnēm</translation>
<translation id="80790299200510644">Attēlu meklēšana</translation>
<translation id="8086881907087796310">Instalēšana neizdevās, jo jūsu dators neatbilst minimālajām aparatūras prasībām.</translation>
<translation id="8263061319795838019"><ph name="PAGE_TITLE"/> — Freedom for Testing</translation>
<translation id="2061155704815580583">Pārlūkam Freedom ir nepieciešama atrašanās vietas atļauja šai vietnei.</translation>
<translation id="8118331347066725040">Sūtiet atsauksmes par meklēšanu, izmantojot Lens</translation>
<translation id="5334309298019785904">Freedom OS nevarēja sinhronizēt jūsu datus, jo jūsu domēnā nav pieejama sinhronizācija.</translation>
<translation id="813913629614996137">Notiek inicializēšana...</translation>
<translation id="9067428552314418522">Šis fails ir bīstams, tāpēc Freedom to bloķēja.</translation>
<translation id="8177472873527554730">Nevar atrast saturu lapā</translation>
<translation id="6219250889396046657">Lai savā kontā (<ph name="USER_EMAIL"/>) izmantotu un saglabātu Freedom datus, ievadiet ieejas frāzi.</translation>
<translation id="8221491193165283816">Parasti jūs bloķējat paziņojumus. Lai ļautu šai vietnei sūtīt jums paziņojumus, noklikšķiniet šeit.</translation>
<translation id="8377926237617998195">Lai izmantotu kameru, piešķiriet pārlūkam Freedom piekļuvi <ph name="BEGIN_LINK"/>sistēmas iestatījumos<ph name="END_LINK"/>.</translation>
<translation id="1755067029031059271">Freedom nevar pārbaudīt šī paplašinājuma izcelsmi, un, iespējams, tas nav drošs. Noņemiet to no pārlūka Freedom, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp personas informāciju.</translation>
<translation id="8207657266087451193">Ja attēlam nav vērtīga apraksta, pārlūks Freedom mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Freedom. Jebkurā brīdī iestatījumos varat izslēgt šo iespēju.</translation>
<translation id="7792526144795244436">Vai pierakstīties pārlūkā Freedom, izmantojot jaunu profilu?</translation>
<translation id="976541154724186511">Pārlūkā <ph name="BEGIN_LINK"/>Freedom tiek rādīti brīdinājumi<ph name="END_LINK"/> par nedrošām vietnēm un lejupielādēm</translation>
<translation id="8060549744348950090">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Freedom tika noņemta šāda atļauja: <ph name="PERMISSION"/>.</translation>
<translation id="8313851650939857356">Palaišanas kļūda: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="6098476632210317894">Jūsu organizācija aizver pārlūku Freedom, ja tas <ph name="TIMEOUT_DURATION"/> netiek izmantots.</translation>
<translation id="8321888067342493336">Saglabāt kā attēlu</translation>
<translation id="3360368475735266712">Pierakstieties, lai sinhronizētu un personalizētu pārlūku Freedom visās savās ierīcēs.</translation>
<translation id="2591326305549412656"><ph name="USER_EMAIL_ADDRESS"/> iepriekš izmantoja Freedom</translation>
<translation id="5592122595094519401">Lai turpinātu izmantot Freedom datus savā Freedom kontā (<ph name="ACCOUNT_EMAIL"/>), atjauniniet pārlūku Freedom.</translation>
<translation id="2569754604093464025">Lai saņemtu turpmākus Freedom atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 8.</translation>
<translation id="8362914115861174987">Tulkot šādā valodā:</translation>
<translation id="7296197595428914424">Pierakstieties pārlūkā Freedom, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs. Šī parole tiks saglabāta jūsu Freedom kontā pēc pierakstīšanās.</translation>
<translation id="9098234372282930719">Pēc tam jums būs jārestartē pārlūks Freedom.</translation>
<translation id="1327729221471951979">Freedom iesaka to noņemt. <ph name="BEGIN_LINK"/>Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK"/>.</translation>
<translation id="8577108764439626300">Šī paplašinājuma publicēšanu atcēla izstrādātājs, un paplašinājums, iespējams, nav drošs. Noņemiet to no pārlūka Freedom, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="4234753748520037091">Pārlūkā Freedom ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Freedom kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati tiks dzēsti.</translation>
<translation id="5337999052834672687">{0,plural, =1{Restartējiet pārlūku Freedom vienas dienas laikā}zero{Restartējiet pārlūku Freedom # dienu laikā}one{Restartējiet pārlūku Freedom # dienas laikā}other{Restartējiet pārlūku Freedom # dienu laikā}}</translation>
<translation id="8438543370129609977">Kad izmantojat funkciju Attēlu meklēšana, serverim tiek nosūtīts lapas nosaukums, URL un saturs, tostarp PDF faili. <ph name="LEARN_MORE"/></translation>
<translation id="6914496861676471566">Instalēšanas programmas arhīvs ir bojāts vai nav derīgs. Lejupielādējiet Freedom vēlreiz.</translation>
<translation id="4378573854226202617">Pārlūka Freedom izmantošanai nepieciešama operētājsistēma Windows 10 vai jaunāka versija.</translation>
<translation id="6431861494713261006">Neobligāti: palīdziet uzlabot Freedom OS funkcijas un veiktspēju, automātiski nosūtot Freedom serveriem diagnostikas un lietojuma datus.</translation>
<translation id="8691137711639873980">Lai izmantotu un saglabātu Freedom datus savā Freedom kontā, apstipriniet savu identitāti.</translation>
<translation id="3251012123600267109">Tiek rādīti aicinājumi pierakstīties pārlūkā Freedom.</translation>
<translation id="2097604701283463988">Freedom versija ir novecojusi</translation>
<translation id="871233388178581868">Pārlūkprogrammā Freedom var pārbaudīt jūsu paroles, ja jūs tās saglabājat.</translation>
<translation id="8555465886620020932">Pakalpojuma kļūda: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="8556420416730706394">Varat piespraust funkciju Attēlu meklēšana, lai ērti tai piekļūtu. Sānu paneļa augšdaļā noklikšķiniet uz pogas “Piespraust”.</translation>
<translation id="856656450041460113">Meklēt valodu sarakstā</translation>
<translation id="227028348235968071">Pārlūkprogrammā Freedom var pārbaudīt jūsu paroles, ja esat pierakstījies savā Freedom kontā.</translation>
<translation id="839677568225616901">Pārlūku Freedom pārvalda vairākas organizācijas</translation>
<translation id="8121009781989288430">Autortiesības <ph name="YEAR"/> Freedom autori. Visas tiesības paturētas.</translation>
<translation id="8601359445272098721">Jaunums! Atlasot pogu “Tulkot ekrānu”, varat tulkot gan ekrānā redzamo tekstu, gan attēlus.</translation>
<translation id="3052349005266761501">Notiek Freedom palaišana...</translation>
<translation id="5128665650717824082">Freedom for Testing nevar iestatīt kā noklusējuma pārlūku.</translation>
<translation id="2433912322225810055">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku Freedom vai meklēsiet, izmantojot universālo lodziņu.</translation>
<translation id="4100716194836114130">Šis ir jūsu Freedom</translation>
<translation id="8712637175834984815">Sapratu!</translation>
<translation id="1419543648228375718">Vai pierakstīties pārlūkā Freedom?</translation>
<translation id="8747073452963259673">meklēšanas apgabala apakšējais kreisais stūris: <ph name="LEFT"/>% pa kreisi, <ph name="BOTTOM"/>% apakšdaļā</translation>
<translation id="878572486461146056">Instalēšanas kļūda: administrators ir piemērojis grupas politiku, kas neļauj veikt instalēšanu: <ph name="INSTALL_ERROR"/>.</translation>
<translation id="4831743161813926460">Pārlūkam Freedom ir nepieciešama atļauja piekļūt jūsu kamerai un mikrofonam šajā vietnē.</translation>
<translation id="64216977793816291">Vai pierakstīties pārlūkā Freedom?</translation>
<translation id="7447364954121496869">Iestatīt Freedom kā noklusējuma pārlūku un piespraust to uzdevumu joslai</translation>
<translation id="8826492472752484139">Noklikšķiniet uz vienuma Paroļu pārvaldnieks.</translation>
<translation id="6933858244219479645">Freedom OS sistēma</translation>
<translation id="9084132286318231275">Šī valoda tiek izmantota, lai rādītu izvēlnes, iestatījumus, brīdinājumus un citu tekstu pārlūkā Freedom.</translation>
<translation id="8862326446509486874">Jums nav vajadzīgo tiesību, lai instalētu sistēmas līmenī. Mēģiniet vēlreiz palaist instalēšanas programmu kā administrators.</translation>
<translation id="7289323009146924152">Pievienot Freedom profilu</translation>
<translation id="6412037018950369131">Ja tā ir, lūdzu, rediģējiet saglabāto paroli pārlūkprogrammā Freedom, lai tā atbilstu jūsu jaunajai parolei.</translation>
<translation id="1150745254876977823">Saskaņā ar jūsu organizācijas politiku jums ir jāpierakstās pārlūkā Freedom.</translation>
<translation id="8285294305439559616">Freedom mēģina rādīt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
