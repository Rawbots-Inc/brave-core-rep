{
  "manifest_version": 3,
  "name": "Rep Sky",
  "key": "",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "tabs",
    "contextMenus",
    "offscreen",
    "windows",
    "runtime"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "externally_connectable": {
    "matches": [
      "https://dev.rep.run/*",
      "https://app.prod.verisoul.ai/*"
    ]
  }
}